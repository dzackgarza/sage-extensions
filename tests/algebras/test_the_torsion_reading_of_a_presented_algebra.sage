r"""Torsion of a presented algebra is what a non-zero-divisor of the scalars kills.

A one-term relation ``c w`` with ``c`` a non-zero-divisor and ``w``'s class
nonzero is a torsion element, so ``Z[x]/(2x)`` and ``Z[x]/(2x^2)`` are not
torsion-free.  A scalar that is a zero-divisor is not such a witness: in
``Z/4`` the non-zero-divisors are the units, ``2 * 2 = 0``, and a unit kills no
nonzero element -- so ``Z/4[x]/(2x)`` and ``Z/4[x]/(2x^2)`` are torsion-free
although their relation's scalar is nonzero.  ``Z[x]/(x^2)``, whose one
relation has the unit ``1`` as its coefficient, states no torsion either.
"""

from sage_extensions.all import *  # noqa: F401,F403


def test_two_kills_the_class_of_x() -> None:
    r"""``Z[x]/(2x)``: ``2 x = 0`` while ``x`` and ``2`` are both nonzero.

    ``Z`` is a domain, so ``2`` is a non-zero-divisor there and not a unit:
    the class of ``x`` is torsion and the algebra is not torsion-free.
    """
    x = ZZ["x"].algebra_generator("x")
    algebra = ZZ["x"].quotient_by_relations([2 * x])
    xbar = algebra.algebra_generator("x")

    assert 2 * xbar == algebra.zero()
    assert xbar != algebra.zero()
    assert algebra.is_torsion_free() is False


def test_two_kills_the_class_of_x_squared() -> None:
    r"""``Z[x]/(2x^2)``: ``2 x^2 = 0`` with ``x^2`` and ``x`` both nonzero.

    The same non-zero-divisor kills a higher class here; ``x`` itself is not
    killed, so the torsion is the submodule generated by ``x^2``.
    """
    x = ZZ["x"].algebra_generator("x")
    algebra = ZZ["x"].quotient_by_relations([2 * x**2])
    xbar = algebra.algebra_generator("x")

    assert 2 * xbar**2 == algebra.zero()
    assert xbar**2 != algebra.zero()
    assert xbar != algebra.zero()
    assert algebra.is_torsion_free() is False


def test_the_dual_numbers_state_no_torsion() -> None:
    r"""``Z[x]/(x^2)``: the only relation is ``1 * x^2``, and a unit kills nothing.

    ``Z[x]/(x^2)`` is free on ``1`` and ``x`` over ``Z``, and ``x^2 = 0`` is
    not an annihilator of a nonzero class: a non-zero-divisor of ``Z`` killing
    ``a + b x`` forces ``a = b = 0``.
    """
    x = ZZ["x"].algebra_generator("x")
    algebra = ZZ["x"].quotient_by_relations([x**2])
    xbar = algebra.algebra_generator("x")

    assert xbar**2 == algebra.zero()
    assert xbar != algebra.zero()
    assert algebra.is_torsion_free() is True


def test_a_zero_divisor_states_no_torsion_over_z_four() -> None:
    r"""``Z/4[x]/(2x)``: ``2`` is a zero-divisor of ``Z/4``, so ``2x = 0`` is not torsion.

    The non-zero-divisors of ``Z/4`` are its units -- ``2 * 2 = 0`` and ``2``
    is not a unit -- and a unit kills no nonzero element, so no non-zero-divisor
    kills a nonzero class here: the algebra is torsion-free although
    ``2 x = 0``.
    """
    x = Zmod(4)["x"].algebra_generator("x")
    algebra = Zmod(4)["x"].quotient_by_relations([2 * x])
    xbar = algebra.algebra_generator("x")

    assert 2 * xbar == algebra.zero()
    assert xbar != algebra.zero()
    assert algebra.is_torsion_free() is True


def test_a_zero_divisor_states_no_torsion_over_z_four_mod_two_x_squared() -> None:
    r"""``Z/4[x]/(2x^2)``: the same zero divisor, and again no torsion.

    ``2 x^2 = 0`` is no more an annihilator of a nonzero class than ``2 x = 0``
    was: ``2`` is a zero-divisor of ``Z/4``, and every non-zero-divisor there is
    a unit.
    """
    x = Zmod(4)["x"].algebra_generator("x")
    algebra = Zmod(4)["x"].quotient_by_relations([2 * x**2])
    xbar = algebra.algebra_generator("x")

    assert 2 * xbar**2 == algebra.zero()
    assert xbar**2 != algebra.zero()
    assert algebra.is_torsion_free() is True
