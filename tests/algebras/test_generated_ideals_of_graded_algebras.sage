r"""The ordinary and the divided-power ideal of a graded power algebra.

Both are generated in degree one and both are graded, so each degree piece is
the image of the retained products: in degree ``d`` the ordinary ideal is
spanned by ``x k y`` with ``deg x + deg y = d - 1``, and the divided-power ideal
of ``Gamma(M)`` also contains ``gamma_j(k) A_{d-j}``.

``Gamma(ZZ x)`` with ``k = 2x`` separates them, because ``gamma_j`` is not a
polynomial in ``x`` over ``ZZ``:

* ``gamma_3(2x) = 8 gamma_3(x)`` is a divided power of the generator itself;
* the ordinary ideal in degree three is ``2x * ZZ gamma_2(x) = 6 ZZ gamma_3(x)``;
* so ``8 gamma_3(x)`` is in one and not the other, and ``6 gamma_3(x)`` is in both.

Over ``QQ`` the two ideals agree, because ``2`` is a unit: the same element is in
the ordinary ideal there.  The difference is an arithmetic fact about ``ZZ``,
not a difference of construction.
"""

import pytest

from sage_extensions.all import *  # noqa: F401,F403


def _divided_line(ring=ZZ):
    r"""``Gamma(R x)`` with its degree-one generator."""
    divided = Modules(ring).free_module(("x",)).divided_power_algebra()
    return divided, divided.degree_one_generator("x")


def test_the_divided_power_ideal_is_strictly_larger_than_the_ordinary_one() -> None:
    r"""In ``Gamma(ZZ x)``, ``gamma_3(2x) = 8 gamma_3(x)`` is in the divided-power
    ideal generated by ``2x`` and outside the ordinary one."""
    divided, x = _divided_line()
    gamma_3 = divided.divided_power(x, 3)
    gamma_3_of_2x = divided.divided_power(2 * x, 3)

    assert gamma_3_of_2x == 8 * gamma_3

    divided_power_ideal = divided.divided_power_ideal([2 * x])
    ordinary_ideal = divided.ideal([2 * x])

    assert gamma_3_of_2x in divided_power_ideal
    assert gamma_3_of_2x not in ordinary_ideal
    assert 6 * gamma_3 in ordinary_ideal
    assert 6 * gamma_3 in divided_power_ideal
    assert 4 * gamma_3 not in ordinary_ideal
    # The divided-power ideal in degree three is 2 ZZ gamma_3(x): it holds 4 and
    # 8, and not 7.
    assert 4 * gamma_3 in divided_power_ideal
    assert 7 * gamma_3 not in ordinary_ideal
    assert 7 * gamma_3 not in divided_power_ideal


def test_over_qq_the_two_ideals_of_2x_agree_because_2_is_a_unit() -> None:
    r"""The separation is arithmetic: over ``QQ``, ``8 gamma_3(x) = 2 (4 gamma_3(x))``
    is already in the ordinary ideal generated by ``2x``."""
    divided, x = _divided_line(QQ)
    gamma_3_of_2x = divided.divided_power(2 * x, 3)

    assert gamma_3_of_2x in divided.divided_power_ideal([2 * x])
    assert gamma_3_of_2x in divided.ideal([2 * x])
    # 2x is a unit multiple of x, so the ordinary ideal generated by it is all of
    # the augmentation ideal: it meets degree three in all of Gamma^3.
    assert divided.divided_power(x, 3) in divided.ideal([2 * x])


def test_the_two_ideals_state_which_flavor_they_are_and_meet_in_degree_one() -> None:
    r"""Both ideals are generated by the same degree-one element, and the object
    says which ideal it is rather than leaving that to its name."""
    divided, x = _divided_line()
    divided_power_ideal = divided.divided_power_ideal([2 * x])
    ordinary_ideal = divided.ideal([2 * x])

    assert divided_power_ideal.is_divided_power_ideal() is True
    assert ordinary_ideal.is_divided_power_ideal() is False
    assert divided_power_ideal.ambient_algebra() is divided
    assert divided_power_ideal.algebra_generators() == (2 * x,)
    assert ordinary_ideal.algebra_generators() == (2 * x,)
    assert divided_power_ideal is not ordinary_ideal

    for ideal in (divided_power_ideal, ordinary_ideal):
        assert 2 * x in ideal
        assert 3 * x not in ideal
        assert x not in ideal
        assert divided.zero() in ideal


def test_the_degree_pieces_of_the_ordinary_ideal_are_the_retained_products() -> None:
    r"""Degree ``d`` of ``(2x)`` is ``2x * Gamma^{d-1}``: ``2 ZZ gamma_2(x)`` and
    ``6 ZZ gamma_3(x)``, whose generators are read from the piece itself."""
    divided, x = _divided_line()
    ordinary_ideal = divided.ideal([2 * x])
    gamma_2 = divided.divided_power(x, 2)

    assert ordinary_ideal.graded_piece(1).module_rank() == 1
    assert ordinary_ideal.graded_piece(2).module_rank() == 1

    piece_2 = ordinary_ideal.graded_piece(2)
    label = next(iter(piece_2.module_generating_set()))
    # The piece carries its own frame, and the retained degree inclusion places
    # it in the algebra's own Gamma^2, where it is the product 2x * x.
    #
    # The *algebra* element gamma_2(x) prints identically to its own degree-two
    # component but is a different parent: a graded sum and its summand are not
    # identified, so the comparison is made in the piece.
    gamma_2_piece = gamma_2.homogeneous_component(2)
    assert ordinary_ideal.degree_inclusion(2)(piece_2.module_generator(label)) == 4 * gamma_2_piece
    assert divided.from_component(2, 4 * gamma_2_piece) == 2 * x * x
    assert (2 * x * x) == 4 * gamma_2


def test_the_inclusion_of_a_generated_ideal_is_the_identity_on_its_elements() -> None:
    r"""``I -> A`` restricted to a degree is that degree's inclusion, so an
    element of ``I`` reads back as the ambient element it was taken from."""
    divided, x = _divided_line()
    ordinary_ideal = divided.ideal([2 * x])
    inclusion = ordinary_ideal.inclusion()

    assert inclusion.domain() is ordinary_ideal
    assert inclusion.codomain() is divided

    for degree, ambient_element in (
        (1, 2 * x),
        (2, 4 * divided.divided_power(x, 2)),
        (3, 6 * divided.divided_power(x, 3)),
    ):
        element = ordinary_ideal.from_component(
            degree,
            ordinary_ideal.degree_inclusion(degree).lift(
                ambient_element.homogeneous_component(degree)
            ),
        )
        assert inclusion(element) == ambient_element


def test_the_ideal_generated_by_x_in_an_exterior_algebra_is_two_sided() -> None:
    r"""``Lambda(ZZ x, y)``: ``(x)`` contains ``x wedge y`` but not ``y``, which
    is the two-sided statement ``x A`` in a graded-commutative algebra."""
    exterior = Modules(ZZ).free_module(("x", "y")).exterior_algebra()
    x, y = exterior.degree_one_generator("x"), exterior.degree_one_generator("y")
    ideal = exterior.ideal([x])

    assert x in ideal
    assert x * y in ideal
    assert y * x in ideal
    assert y not in ideal
    assert x * y != exterior.zero()
    # A different generator generates a different degree-two piece: y wedge x,
    # which is the negative of x wedge y, so the two ideals really differ.
    assert (x * y in exterior.ideal([y])) is True
    assert (x in exterior.ideal([y])) is False


def test_an_ideal_generated_in_degree_two_is_refused_rather_than_approximated() -> None:
    r"""The construction is stated for degree-one generators; a degree-two
    generator is not silently placed by the degree-one formula."""
    divided, x = _divided_line()

    with pytest.raises(NotImplementedError):
        divided.ideal([x * x])

    with pytest.raises(NotImplementedError):
        divided.divided_power_ideal([divided.divided_power(x, 2)])


def test_an_empty_generating_family_generates_the_zero_ideal() -> None:
    r"""No generators means the zero submodule: ``0`` is in it and no positive
    degree is."""
    divided, x = _divided_line()
    for ideal in (divided.ideal([]), divided.divided_power_ideal([])):
        assert divided.zero() in ideal
        assert (x in ideal) is False
        assert (divided.divided_power(x, 3) in ideal) is False
        assert ideal.graded_piece(3).module_rank() == 0


def test_generator_images_may_be_keyed_by_the_generators_themselves() -> None:
    r"""A map of polynomial algebras is written ``x |-> v, y |-> w``, and the
    selected generating family's labels are an internal name for the same
    generators: both keyings state one datum, and a key that is neither is
    still refused."""
    source = Modules(QQ).free_module(("x", "y")).symmetric_algebra()
    target = Modules(QQ).free_module(("u", "v", "w")).symmetric_algebra()
    x, y = source.algebra_generator("x"), source.algebra_generator("y")
    v, w = target.algebra_generator("v"), target.algebra_generator("w")

    by_element = source.Mor(target)({x: v, y: w})
    by_label = source.Mor(target)({"x": v, "y": w})
    mixed = source.Mor(target)({x: v, "y": w})

    assert by_element(x * y) == v * w
    assert by_element(x**2 * y + 3) == v**2 * w + 3
    assert by_label(x * y) == v * w
    assert mixed(x**2 * y + 3) == v**2 * w + 3
    assert by_element(x) == v and by_element(y) == w

    with pytest.raises(ValueError):
        source.Mor(target)({x: v})

    with pytest.raises(ValueError):
        source.Mor(target)({x**2: v, y: w})
