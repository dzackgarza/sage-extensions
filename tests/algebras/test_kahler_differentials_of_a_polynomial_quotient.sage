r"""``Omega^1`` of a polynomial quotient is computed over the coefficient ring.

``A = R[x_1, ..., x_n]/I`` states its polynomial cover as base ring, so the
calculus is ``Omega^1_{A/R}``: the conormal module ``I/I^2`` mapped into
``Omega^1_{R[x]/R} (x) A``.  The characteristic shows up where it belongs —
``d(x^2) = 2x dx`` vanishes in both characteristics, and it kills ``x dx``
exactly when ``2`` is invertible.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _dual_numbers(coefficient_ring):
    r"""``R[x]/(x^2)`` with its polynomial cover and the class of ``x``."""
    polynomials = coefficient_ring["x"]
    algebra = polynomials.quotient_ring(polynomials.gen() ** 2)
    return polynomials, algebra, algebra(polynomials.gen())


def _axes():
    r"""``QQ[x, y]/(xy)`` with the two generators of its cover."""
    plane = QQ["x,y"]
    x, y = plane.algebra_generator("x"), plane.algebra_generator("y")
    axes = plane.quotient_ring(plane.ideal([x * y]))
    return plane, axes, axes(x), axes(y)


def test_over_f2_the_differential_module_is_free_on_dx_and_x_dx_is_nonzero() -> None:
    r"""In characteristic ``2``, ``d(x^2) = 2x\,dx = 0`` imposes no relation on ``x\,dx``.

    So ``Omega_A`` is generated by ``dx`` over ``A``, and ``x\,dx`` is a nonzero
    element of it — the fact the de Rham cohomology of the dual numbers turns
    on.  Over a field of characteristic not ``2`` the same computation kills it
    (the next test).
    """
    _polynomials, dual, x = _dual_numbers(GF(2))
    omega = dual.kahler_differentials()
    derivation = omega.universal_derivation()
    dx = derivation(x)

    assert omega.base_ring() is dual
    assert omega.module_generating_set().cardinality() == 1
    assert derivation(dual.one()) == omega.zero()
    assert dx != omega.zero()
    assert derivation(x * x) == omega.zero()
    assert x * dx != omega.zero()


def test_over_qq_the_same_presentation_kills_x_dx_because_two_is_invertible() -> None:
    r"""``d(x^2) = 2x\,dx = 0`` with ``2`` a unit gives ``x\,dx = 0``, and ``dx`` survives."""
    _polynomials, dual, x = _dual_numbers(QQ)
    omega = dual.kahler_differentials()
    derivation = omega.universal_derivation()
    dx = derivation(x)

    assert omega.base_ring() is dual
    assert omega.module_generating_set().cardinality() == 1
    assert dx != omega.zero()
    assert derivation(x * x) == omega.zero()
    assert x * dx == omega.zero()


def test_the_conormal_image_of_the_relation_of_the_axes_is_y_dx_plus_x_dy() -> None:
    r"""For ``A = QQ[x,y]/(xy)``: ``I/I^2`` is generated by ``xy`` and maps to ``y\,dx + x\,dy``.

    That is the conormal sequence ``I/I^2 -> Omega^1_{P/R} (x)_P A -> Omega^1_{A/R} -> 0``
    for the single relation of the presentation.  The universal derivation of
    the quotient is not available here — it needs a kernel over ``A``, which is
    a polynomial quotient and not a principal ideal domain (``TRAPS.md``) — so
    the statement is made on the conormal map the construction does retain.
    """
    _plane, axes, x, y = _axes()
    omega = axes.kahler_differentials()
    conormal_map = omega.conormal_morphism()
    conormal = omega.conormal_module()
    ambient = omega.ambient_differentials()

    assert omega.base_ring() is axes
    assert omega.module_generating_set().cardinality() == 2
    assert conormal.module_generating_set().cardinality() == 1
    assert conormal_map.domain() is conormal
    assert conormal_map.codomain() is ambient

    image = conormal_map(conormal.module_generator(0))
    dx, dy = ambient.module_generator(("d", "x")), ambient.module_generator(("d", "y"))
    assert image != ambient.zero()
    assert image == y * dx + x * dy
