r"""The subalgebra generated by a homogeneous element, decided exactly.

``Algebra.adjoin R s`` is the smallest ``R``-subalgebra containing ``s``
(Mathlib, ``Algebra/Algebra/Subalgebra/Lattice.lean:35``, with the universal
property ``Algebra.gc``).  In a graded algebra with homogeneous generators of
positive degree its degree-``d`` part is spanned by the products of generators
whose degrees sum to ``d``, which is what makes membership decidable: the words
of one degree are finite, and their span is the image of one module morphism.

``Gamma(ZZ[x])`` is the specimen that states the difference between divided
powers and polynomials.  A degree-``n`` word in ``x`` is ``x^n = n! gamma_n(x)``,
so ``x*x = 2 gamma_2(x)`` and ``x^3 = 6 gamma_3(x)`` lie in the subalgebra
generated by ``x``, while ``gamma_2(x)`` and ``3 gamma_3(x)`` do not: no integer
``c`` solves ``2c = 1`` or ``6c = 3``.  Over ``QQ`` the same element *is*
generated, because ``2`` is invertible -- the decision is arithmetic, not a name.
"""

from sage_extensions.all import *  # noqa: F401,F403

import pytest


def _integral_divided_power_algebra():
    algebra = Modules(ZZ).free_module(("x",)).divided_power_algebra()
    return algebra, algebra.degree_one_generator("x")


def test_the_subalgebra_generated_by_x_is_the_words_in_x_over_the_integers() -> None:
    r"""Exactly the multiples of ``n! gamma_n(x)`` are generated, and no others.

    ``x``, ``x*x = 2 gamma_2(x)`` and ``x^3 = 6 gamma_3(x)`` are words in ``x``;
    ``gamma_2(x)`` and ``3 gamma_3(x)`` are not, because their coefficients are
    not the factorials a word produces.
    """
    algebra, x = _integral_divided_power_algebra()
    generated = algebra.subalgebra([x])
    gamma2, gamma3 = algebra.divided_power(x, 2), algebra.divided_power(x, 3)

    assert x in generated
    assert x * x in generated
    assert 2 * gamma2 in generated
    assert x**3 in generated
    assert 6 * gamma3 in generated
    assert 3 * gamma3 not in generated
    assert gamma2 not in generated
    assert algebra.one() in generated
    assert algebra.zero() in generated


def test_over_the_rationals_the_divided_power_is_generated() -> None:
    r"""Over ``QQ`` the same generator generates ``gamma_2(x) = x*x/2``.

    ``2`` is a unit, so the coefficient that excludes ``gamma_2`` from the
    integral subalgebra is no obstruction here.  A construction that answered by
    the name of the element rather than by its coefficients would answer the
    same way in both fields.
    """
    algebra = Modules(QQ).free_module(("x",)).divided_power_algebra()
    x = algebra.degree_one_generator("x")
    generated = algebra.subalgebra([x])

    assert algebra.divided_power(x, 2) in generated
    assert (QQ(1) / QQ(2)) * (x * x) in generated
    assert x in generated


def test_several_generators_generate_exactly_their_words() -> None:
    r"""Two generators generate the words in both, and no divided power of one.

    ``Gamma(ZZ[x, y])`` in degree ``n`` is spanned by ``x^a y^b`` with ``a + b = n``,
    so ``x``, ``y``, ``x*y``, ``x*x`` and ``x^2 y`` are generated.  ``gamma_2(x)``
    is not: a word of degree two is a multiple of ``x*x = 2 gamma_2(x)``,
    ``x*y`` or ``y*y = 2 gamma_2(y)``, and no integer combination of those is
    ``gamma_2(x)`` or ``gamma_2(x) + gamma_2(y)``.
    """
    algebra = Modules(ZZ).free_module(("x", "y")).divided_power_algebra()
    x, y = algebra.degree_one_generator("x"), algebra.degree_one_generator("y")
    generated = algebra.subalgebra([x, y])

    assert x in generated and y in generated
    assert x * y in generated
    assert x * x in generated
    assert x * x * y in generated
    assert algebra.divided_power(x, 2) not in generated
    assert algebra.divided_power(x, 2) + algebra.divided_power(y, 2) not in generated


def test_over_the_rationals_two_generators_generate_their_divided_powers() -> None:
    r"""Over ``QQ`` the same two generators do generate ``gamma_2`` of each.

    ``gamma_2(x) = (x*x)/2`` and ``2`` is a unit there, so the integral exclusion
    is arithmetic again; both fields are decided by the same construction.
    """
    algebra = Modules(QQ).free_module(("x", "y")).divided_power_algebra()
    x, y = algebra.degree_one_generator("x"), algebra.degree_one_generator("y")
    generated = algebra.subalgebra([x, y])

    assert algebra.divided_power(x, 2) in generated
    assert algebra.divided_power(x, 2) + algebra.divided_power(y, 2) in generated
    assert x * y in generated


def test_the_generated_subalgebra_retains_its_ambient_algebra_and_generators() -> None:
    r"""The subalgebra is a subobject: it names the ambient algebra and its generators.

    Its points are the ambient algebra's elements (``x in generated`` asks the
    ambient element), and its base ring is the algebra's own, not a fixed ``ZZ``.
    """
    algebra, x = _integral_divided_power_algebra()
    generated = algebra.subalgebra([x])

    assert generated.ambient_ring() is algebra
    assert generated.base_ring() is ZZ
    assert generated in GeneratedSubalgebras(ZZ)
    assert generated.inclusion().domain() is generated
    assert generated.inclusion().codomain() is algebra
    assert tuple(generated.algebra_generators()) == (x,)
    assert x in generated and generated.defining_predicate()(x) is True


def test_the_inclusion_is_an_algebra_morphism_in_both_characteristics() -> None:
    r"""The subobject is an algebra, and its inclusion is an algebra morphism.

    ``Subgroups(G)`` returns a group with an inclusion and ``ModuleSubobjects``
    a module with an inclusion; this is that shape for algebras.  The product on
    the subalgebra is transported through the degree inclusions -- the two
    carriers stay distinct -- so the inclusion is unital and multiplicative, and
    it sends the subalgebra's square of its degree-one generator to
    ``2 gamma_2(x)`` over both ``ZZ`` and ``QQ``.
    """
    for base in (ZZ, QQ):
        algebra = Modules(base).free_module(("x",)).divided_power_algebra()
        x = algebra.degree_one_generator("x")
        generated = algebra.subalgebra([x])
        inclusion = generated.inclusion()
        piece = generated.graded_piece(1)
        generator = generated.from_component(
            1, piece.module_generator(piece.module_generating_set()[0])
        )

        assert inclusion(generated.one()) == algebra.one()
        assert inclusion(generator) == x
        assert inclusion(generator * generator) == inclusion(generator) * inclusion(generator)
        assert inclusion(generator * generator) == 2 * algebra.divided_power(x, 2)
        assert generated.one() * generator == generator


def test_a_generator_the_graded_realization_cannot_use_says_so() -> None:
    r"""A degree-zero or nonhomogeneous generator is refused, not approximated.

    The realization decides membership from the graded words, so it needs
    homogeneous generators of positive degree: a degree-zero one would need the
    generated part of a subring, and a nonhomogeneous one would need products
    whose degrees do not add up.
    """
    algebra, x = _integral_divided_power_algebra()

    with pytest.raises(NotImplementedError):
        algebra.subalgebra([algebra.one()])
    with pytest.raises(AssertionError):
        algebra.subalgebra([x + algebra.divided_power(x, 2)])
