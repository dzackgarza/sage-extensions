r"""Conjugation by the identity of a group acts as the identity on subgroups.

A group $G$ acts on its set of subgroups by $g.H = gHg^{-1}$.  An action is a
function on the point set, so the identity element fixes every point: what it
answers for $H$ is $H$ itself, with the datum $H$ retains, and not a second
subgroup that happens to have the same elements.  Stated in the classifying
category, the action functor sends the identity arrow of $BG$ to the identity
map of the subgroup set.

An element of $H$, or one outside it that normalizes it, also names the point
$H$; the answer is the pair $(H, g)$ the action law composes, whose image is
$H$.  So the two answers a normalizing element gives -- the subgroup and the
pair it was built from -- are read apart: the elements are $H$'s, and
``g.(h.H) = (gh).H`` holds because the pair, not the subgroup object, is what
the next conjugation composes with.

In $S_3$, conjugation by $(1\,3)$ carries the subgroup generated by the
transposition $(1\,2)$ to the subgroup generated by $(2\,3)$: the two have the
same order and different elements, so the identity case is not the whole
action.
"""

from sage_extensions.all import *  # noqa: F401,F403


def test_the_identity_element_conjugates_a_subgroup_to_itself() -> None:
    group = Groups.S(3)
    subgroup = group.subgroup((group((1, 2)),))

    assert group.conjugate_subgroup(group.one(), subgroup) is subgroup


def test_the_conjugation_action_sends_the_identity_arrow_to_the_identity_map() -> None:
    group = Groups.S(3)
    subgroup = group.subgroup((group((1, 2)),))
    action = group.subgroup_conjugation_g_set().action_functor()
    point = action.domain().an_object()
    identity = action.domain().Mor(point, point)(group.one())

    assert action(identity)(subgroup) is subgroup


def test_a_three_cycle_conjugates_the_subgroup_of_a_transposition() -> None:
    group = Groups.S(3)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))
    conjugate = group.conjugate_subgroup(group((1, 3)), subgroup)

    assert conjugate.order() == 2
    assert group((2, 3)) in conjugate
    assert transposition not in conjugate


def test_an_element_of_the_subgroup_conjugates_it_to_itself() -> None:
    r"""$(1\,2)$ carries $H$ to $H$ as a set, and the answer is the pair $(H, (1\,2))$."""
    group = Groups.S(3)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))

    conjugate = group.conjugate_subgroup(transposition, subgroup)

    assert conjugate.order() == subgroup.order()
    assert all(subgroup.is_parent_of(member) for member in conjugate)
    assert conjugate.conjugated_subgroup() is subgroup
    assert conjugate.conjugator() == transposition


def test_an_element_outside_the_subgroup_that_normalizes_it_fixes_it() -> None:
    r"""$(3\,4)$ lies outside $\langle(1\,2)\rangle$ in $S_4$ and commutes with $(1\,2)$.

    Its conjugation fixes the subgroup as a set, so the point it names is $H$
    and not a subgroup with other elements; the answer is the pair $(H,
    (3\,4))$, which is what the action law composes.
    """
    group = Groups.S(4)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))
    outside = group((3, 4))

    assert outside not in subgroup
    conjugate = group.conjugate_subgroup(outside, subgroup)
    assert conjugate.order() == subgroup.order()
    assert all(subgroup.is_parent_of(member) for member in conjugate)
    assert conjugate.conjugator() == outside
