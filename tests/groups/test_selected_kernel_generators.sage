r"""Squaring C6 has the order-two subgroup generated by the cube as kernel."""

from sage_extensions.all import *


def test_squaring_kernel_has_the_supplied_free_generating_datum():
    group = Groups.C(6)
    generator = group.group_generators()[0]
    square = group.Mor(group)(lambda element: element**2)
    square.select_kernel_generators(lambda: Set((generator**3,)))
    kernel = square.kernel()
    assert kernel.kernel_morphism() is square
    assert generator**3 in kernel
    assert generator not in kernel
    assert kernel.cardinality() == cardinal(2)
    family = tuple(kernel.group_generators())
    assert group.subgroup(family).cardinality() == cardinal(2)
    assert all(square(element) == group.one() for element in family)
