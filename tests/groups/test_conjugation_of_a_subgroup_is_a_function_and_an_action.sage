r"""Conjugating a subgroup is a function of the element and the subgroup, and it is an action.

A group $G$ acts on its set of subgroups by $g.H = gHg^{-1}$.  Two things
follow, and neither is a property of a chosen enumeration of the subgroup:

* The formula names one subgroup for one pair, so two conjugations of the same
  subgroup by the same element are one subgroup, not two subgroups with the
  same elements.
* The action law $g.(h.H) = (gh).H$ holds, so an element whose conjugation
  returns to the identity returns to the subgroup it started from.  In $S_3$ a
  transposition is its own inverse, so conjugating twice by it is the identity
  action and answers $\langle(1\,2)\rangle$ itself.

The conjugation is by the element, not by its inverse: in $S_3$ the three-cycle
$(1\,2\,3)$ carries $\langle(1\,2)\rangle$ to the subgroup generated by
$(2\,3) = (1\,2\,3)(1\,2)(1\,3\,2)$, and not to $\langle(1\,3)\rangle$, which
is the same three-cycle read the other way.
"""

from sage_extensions.all import *  # noqa: F401,F403


def test_a_three_cycle_carries_the_subgroup_of_a_transposition_to_its_own_conjugate() -> None:
    r"""$(1\,2\,3)\langle(1\,2)\rangle(1\,3\,2) = \langle(2\,3)\rangle$."""
    group = Groups.S(3)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))
    conjugate = group.conjugate_subgroup(group((1, 2, 3)), subgroup)

    assert conjugate.order() == 2
    assert group((2, 3)) in conjugate
    assert transposition not in conjugate
    assert group((1, 3)) not in conjugate


def test_two_conjugations_by_one_element_are_one_subgroup() -> None:
    group = Groups.S(3)
    subgroup = group.subgroup((group((1, 2)),))
    three_cycle = group((1, 2, 3))

    assert group.conjugate_subgroup(three_cycle, subgroup) is group.conjugate_subgroup(
        three_cycle, subgroup
    )


def test_conjugating_twice_by_a_transposition_returns_the_subgroup() -> None:
    r"""A transposition is its own inverse, so $(1\,3)^2.H = 1.H = H$.

    The subgroup answered here is the subgroup that was conjugated, with the
    generating family it was constructed from, and not a second subgroup with
    the same two elements.
    """
    group = Groups.S(3)
    subgroup = group.subgroup((group((1, 2)),))
    transposition = group((1, 3))

    assert group.conjugate_subgroup(
        transposition, group.conjugate_subgroup(transposition, subgroup)
    ) is subgroup


def test_conjugating_along_a_product_is_conjugating_by_the_product() -> None:
    r"""$g.(h.H) = (gh).H$: the conjugation is the action of the group on its subgroups.

    In $S_3$ with $H = \langle(1\,2)\rangle$ and $g = h = (1\,2\,3)$, the
    composite is the inverse three-cycle and the answer is
    $\langle(1\,3)\rangle$, which is neither $H$ nor the subgroup
    $\langle(2\,3)\rangle$ that one conjugation by $g$ gives.
    """
    group = Groups.S(3)
    subgroup = group.subgroup((group((1, 2)),))
    three_cycle = group((1, 2, 3))

    left = group.conjugate_subgroup(three_cycle, group.conjugate_subgroup(three_cycle, subgroup))
    right = group.conjugate_subgroup(three_cycle * three_cycle, subgroup)

    assert group((1, 3)) in left
    assert group((2, 3)) not in left
    assert left is right


def test_a_normalizing_element_composes_in_the_action() -> None:
    r"""$g.(h.H) = (gh).H$ when $h$ lies in $H$.

    $H = \langle(1\,2)\rangle$ is carried to itself by its own element
    $(1\,2)$, so $h.H$ is the point $H$; the law still names the pair, and
    $g = (1\,3)$ must carry $h.H$ to the subgroup $gh = (1\,2\,3)$ names.  An
    answer that reads $h.H$ as $H$ itself reads $g.(h.H)$ off the pair $(H, g)$
    while $(gh).H$ is the pair $(H, gh)$: two subgroups with the same two
    elements, carrying $(2\,3)$.
    """
    group = Groups.S(3)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))
    flagging = group((1, 3))

    left = group.conjugate_subgroup(
        flagging, group.conjugate_subgroup(transposition, subgroup)
    )
    right = group.conjugate_subgroup(flagging * transposition, subgroup)

    assert left is right
    assert group((2, 3)) in left
    assert transposition not in left


def test_a_conjugate_by_an_element_it_contains_retains_the_pair() -> None:
    r"""$h.H$ states the pair $(H, h)$ its image is read from.

    The conjugate of a subgroup by an element of it is that subgroup as a
    point, and the subgroup it answers is the image of the pair: $h$ carries
    $H$ to itself, so the answer contains $(1\,2)$ and has order two, and it
    retains the subgroup and the element a later conjugation composes with.
    """
    group = Groups.S(3)
    transposition = group((1, 2))
    subgroup = group.subgroup((transposition,))

    conjugate = group.conjugate_subgroup(transposition, subgroup)

    assert conjugate.conjugated_subgroup() is subgroup
    assert conjugate.conjugator() == transposition
    assert conjugate.order() == 2
    assert transposition in conjugate
