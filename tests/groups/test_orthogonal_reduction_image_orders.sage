@pytest.mark.parametrize(
    "case_index,prime,expected",
    (
        (0, 5, 27230655539587500000000000000000),
        (1, 5, 54461311079175000000000000000000),
        (0, 7, 209544577891300558570289055128616960000),
    ),
)
def test_the_generated_reduction_has_its_actual_orthogonal_image_order(case_index, prime, expected):
    case = _RECORDED_IMAGES[case_index]
    lattice = Lattices(ZZ)(case["gram"])
    reduction = lattice.base_change(PrimeFields()(prime).quotient_map())
    group_generators = tuple(
        reduction.O()(tuple(reduction(row) for row in rows))
        for rows in case["generators"]
    )
    image = reduction.O().subgroup(group_generators)

    assert image.cardinality() == cardinal(expected)
