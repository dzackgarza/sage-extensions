r"""Finite-index intersection of two character kernels via ambient generators.

The new branch in predicate_subgroups.IntersectionSubgroups exists exactly for
Γ_h = ρ⁻¹(H) ∩ O⁺(N): neither side is generated, both are finite-index
character kernels of the ambient O(N). Previous branches required one side to
be generated (preimage∩generated or character∩generated) and would fall back
to enumerating the ambient's underlying set — the 5118 MiB CAPPED stage on
case_3. The branch fires only when every intersected subgroup is a predicate
finite-index character kernel *and* the ambient has a retained finite generating
family; otherwise it leaves the intersection undecided, preserving the original
infinite/undecided behavior. Inclusion endpoints are the conjunction predicate
on the ambient: every generator produced lies in every intersected subgroup,
and the generated subgroup equals the predicate intersection (index bound is
the product of the individual finite-character indices, with exact index
available on the intersection itself when character_data is retained).
"""

from sage_extensions.all import *

def test_u_lattice_character_intersection_has_small_generating_family():
    # U = hyperbolic plane, O(U) finite of order 4 (Klein four) with 2 generators
    L = Lattices(ZZ)([[0,1],[1,0]])
    G = L.O()
    assert G.has_selected_group_resolution() is True
    assert G.has_selected_finite_group_generating_set() is True
    assert G.cardinality() == 4
    A = L.discriminant_group()
    OG = A.orthogonal_group()
    H = OG.trivial_subgroup()
    pre = G.discriminant_preimage(H)
    Op = L.O_plus()
    assert pre.contains_character_kernel() is True
    assert Op.contains_character_kernel() is True
    inter = G.intersection(pre, Op)
    # New branch must have fired: intersection now has a selected finite generating family
    assert inter.has_selected_group_resolution() is True
    assert inter.has_selected_finite_group_generating_set() is True
    gens = tuple(inter.group_generators())
    # Every produced generator lies in both character subgroups (inclusion endpoints correct)
    assert all(g in pre and g in Op and g in inter for g in gens)
    # Generated-subgroup equality: subgroup generated by returned generators equals inter
    H_gen = G.subgroup(gens)
    assert H_gen.cardinality() == inter.cardinality()
    assert H_gen.index() == inter.index() == 2
    # Exact index via retained character_data on the intersection itself
    q = inter.finite_character_quotient()
    assert int(q.image_keys().cardinality()) // int(q.subgroup_image_keys().cardinality()) == 2

def test_preimage_intersection_with_generated_subgroup_preserved():
    # Original branch: preimage ∩ generated must still work
    L = Lattices(ZZ)([[0,1],[1,0]])
    G = L.O()
    assert G.has_selected_finite_group_generating_set() is True
    A = L.discriminant_group()
    OG = A.orthogonal_group()
    H = OG.trivial_subgroup()
    pre = G.discriminant_preimage(H)
    g = next(iter(G.group_generators()))
    B = G.subgroup((g,))
    assert B.has_selected_finite_group_generating_set() is True
    inter = G.intersection(pre, B)
    assert inter.has_selected_group_resolution() is True
    assert inter.has_selected_finite_group_generating_set() is True
    gens = tuple(inter.group_generators())
    H_gen = G.subgroup(gens)
    assert H_gen.cardinality() == inter.cardinality()
    assert all(h in pre and h in B for h in gens)

def test_missing_finite_family_rejected_non_vacuously():
    # Non-vacuous regression: ambient has resolution but infinite family,
    # with two genuine finite-index character kernels via valid retained-character contract.
    # Prior implementation would claim a generating family and fail at tuple materialization
    # with hidden error; new lazy branch must preserve undecided and raise exact ValueError.
    from sage_extensions.categories.group.predicate_subgroups import IntersectionSubgroups
    G = Groups.Free(index_set=ZZ)  # countably infinite rank, resolution True, finite False
    assert G.has_selected_group_resolution() is True
    assert G.has_selected_finite_group_generating_set() is False
    C2 = Groups.C(2)
    c = next(iter(C2.group_generators()))
    m1 = G.Mor(C2)(lambda n: c if int(n) % 2 == 0 else C2.one())
    m2 = G.Mor(C2)(lambda n: c if int(n) % 3 == 0 else C2.one())
    # Valid character kernels: predicate is kernel of map to finite group, with correct character_data
    K1 = G.predicate_subgroup(lambda g: m1(g) == C2.one(), "ker m1", character_data={"spinor_kernel": True}, character_data_complete=True)
    K2 = G.predicate_subgroup(lambda g: m2(g) == C2.one(), "ker m2", character_data={"determinant_kernel": True}, character_data_complete=True)
    assert K1.contains_character_kernel() is True
    assert K2.contains_character_kernel() is True
    inter = IntersectionSubgroups(G)((K1, K2))
    assert inter.has_selected_group_resolution() is True
    # has_selected_finite must return False (no finite family), preserving undecided, not raise
    assert inter.has_selected_finite_group_generating_set() is False
    # Non-vacuous exact exception: tuple materialization must raise exact ValueError
    try:
        tuple(inter.group_generators())
        raise AssertionError("expected ValueError for missing finite family")
    except ValueError as e:
        assert "no retained finite generating family" in str(e)
    # Forced unexpected-error regression: ensure arbitrary errors are not hidden as False
    L2 = Lattices(ZZ)([[0,1],[1,0]])
    G2 = L2.O()
    A2 = L2.discriminant_group()
    OG2 = A2.orthogonal_group()
    H2 = OG2.trivial_subgroup()
    pre2 = G2.discriminant_preimage(H2)
    Op2 = L2.O_plus()
    inter2 = G2.intersection(pre2, Op2)
    orig_q = inter2.finite_character_quotient
    def bad_q():
        raise RuntimeError("unexpected")
    inter2.finite_character_quotient = bad_q
    try:
        inter2.has_selected_finite_group_generating_set()
        assert False, "unexpected error should propagate, not become False"
    except RuntimeError as e:
        assert "unexpected" in str(e)
    finally:
        inter2.finite_character_quotient = orig_q
