r"""A generated subgroup of a finite classical group is counted, and its own decision counts it.

The chain the port measured: ``PrimeFields()(5).quotient_map()`` is the retained
map ``ZZ -> ZZ/5``, ``L.orthogonal_group_base_change`` carries isometries of ``L``
to isometries of ``L (x) F_5``, and their images generate a subgroup of the
orthogonal group of that reduction.

The generators below are written out, not taken from an engine's generator list:
``sigma``, ``tau`` and ``upsilon`` are three isometries of ``L = U + A_1(-1)``
given by their images of the lattice basis, and the orders asserted are the
orders of the subgroups they generate — 6 over ``ZZ``, 120 over ``F_5`` — so the
assertions bind to the mathematics and not to the order in which an engine
happens to list a generator family.

Two things stay separated.  *Admission*: a group whose own finiteness decision is
``True`` is counted by its own engine, whatever its placement was before the
question was asked.  *Order*: the count is the engine's order — this file makes no
claim that it is cheap, and it never uses an ambient group's order for it.
"""

from sage_extensions.all import *  # noqa: F401,F403
from sage_extensions.categories.group.groups import (
    OwnedFiniteGroups,
    OwnedInfiniteGroups,
)
from sage_extensions.logic import AtomicProposition


def _lorentzian_lattice():
    r"""``U + A_1(-1)``: rank 3, signature ``(2, 1)``, the small specimen of the port's chain."""
    return Lattices(ZZ)("U") + Lattices(ZZ)("A1").twist(-1)


def _explicit_isometries(lattice):
    r"""Three isometries of ``lattice``, each given by the images of its basis.

    ``sigma`` swaps the hyperbolic pair with signs; ``tau`` and ``upsilon`` are
    the order-three rotations the reduction's 120-element subgroup needs.
    """
    e0, e1, e2 = tuple(lattice.module_generators())
    automorphisms = lattice.Aut()
    sigma = automorphisms((-e1, -e0, e2))
    tau = automorphisms((e0, -e0 + e1 - e2, -2 * e0 - e2))
    upsilon = automorphisms((-e1, -e0 + e1 - e2, -2 * e1 + e2))
    return sigma, tau, upsilon


def _reduction(lattice, prime):
    r"""``L (x) F_p`` along the retained ``PrimeFields()(p).quotient_map()``."""
    ring_map = PrimeFields()(prime).quotient_map()
    assert ring_map.domain() is lattice.base_ring()
    return ring_map, lattice.base_change(ring_map)


def test_the_retained_quotient_map_is_the_base_change_the_lattice_accepts() -> None:
    r"""``PrimeFields()(5).quotient_map()`` starts at the lattice's base ring by identity."""
    lattice = _lorentzian_lattice()
    for prime in (2, 5):
        ring_map, reduction = _reduction(lattice, prime)
        assert ring_map.codomain() is PrimeFields()(prime)
        assert reduction.base_ring() is PrimeFields()(prime)
        assert reduction.base_ring().is_finite() is True


def test_a_generated_subgroup_of_the_reduction_is_counted_without_a_placement_first() -> None:
    r"""``cardinality()`` is asked first: the subgroup's own decision answers it.

    Nothing placed the subgroup as finite — the ambient group's order is not
    read and no finiteness is inferred from the generators — so the count has to
    come from the group's own decision and its own engine.
    """
    lattice = _lorentzian_lattice()
    ring_map, reduction = _reduction(lattice, 5)
    base_change = lattice.orthogonal_group_base_change(ring_map)
    subgroup = reduction.Aut().subgroup(
        tuple(base_change(g) for g in _explicit_isometries(lattice))
    )

    assert (subgroup in OwnedFiniteGroups()) is False
    assert subgroup.cardinality() == cardinal(120)


def test_the_decided_finiteness_is_then_recorded_as_the_placement() -> None:
    r"""Asking the question places the answer; the count does not depend on the order asked."""
    lattice = _lorentzian_lattice()
    ring_map, reduction = _reduction(lattice, 5)
    base_change = lattice.orthogonal_group_base_change(ring_map)
    subgroup = reduction.Aut().subgroup(
        tuple(base_change(g) for g in _explicit_isometries(lattice))
    )

    order = subgroup.cardinality()
    assert subgroup.is_finite() is True
    assert (subgroup in OwnedFiniteGroups()) is True
    assert subgroup.cardinality() == order


def test_the_trivial_subgroup_is_counted() -> None:
    r"""The subgroup generated by nothing has order one."""
    lattice = _lorentzian_lattice()
    _ring_map, reduction = _reduction(lattice, 5)

    trivial = reduction.Aut().subgroup(())
    assert trivial.is_finite() is True
    assert trivial.cardinality() == cardinal(1)


def test_a_finite_subgroup_of_an_infinite_group_is_not_placed_finite_by_its_ambient() -> None:
    r"""``O(L)`` over ``ZZ`` is infinite, and the subgroup ``<sigma, tau>`` has order ``6``.

    The subgroup is never placed finite at construction: its finiteness is its own
    decision, not a consequence of the group it sits in.
    """
    lattice = _lorentzian_lattice()
    sigma, tau, _upsilon = _explicit_isometries(lattice)
    subgroup = lattice.Aut().subgroup((sigma, tau))

    assert (subgroup in OwnedFiniteGroups()) is False
    assert subgroup.is_finite() is True
    assert subgroup.cardinality() == cardinal(6)


def test_an_actually_infinite_generated_subgroup_is_not_counted_as_finite() -> None:
    r"""``<sigma, tau, upsilon>`` over ``ZZ`` is infinite: no finite placement, and ``aleph_0``.

    A finitely generated infinite group is a quotient of a free group of finite
    rank, so it is countably infinite; that is the answer ``cardinality()`` gives,
    and the finite placement is never claimed for it.
    """
    lattice = _lorentzian_lattice()
    subgroup = lattice.Aut().subgroup(_explicit_isometries(lattice))

    assert subgroup.is_finite() is False
    assert (subgroup in OwnedFiniteGroups()) is False
    assert (subgroup in OwnedInfiniteGroups()) is True
    assert subgroup.cardinality() == aleph(0)


def test_an_undecided_finiteness_places_nothing() -> None:
    r"""``O(L)`` over ``ZZ`` states no finiteness answer, so no placement follows.

    The decision is an unevaluated proposition — the engine supplies neither
    answer — and the group is in neither the finite nor the infinite placement.  A
    count cannot be read off a placement that was never made.
    """
    lattice = _lorentzian_lattice()
    ambient = lattice.Aut()

    decision = ambient.is_finite()
    assert isinstance(decision, AtomicProposition)
    assert decision is not True
    assert decision is not False
    assert (ambient in OwnedFiniteGroups()) is False
    assert (ambient in OwnedInfiniteGroups()) is False
