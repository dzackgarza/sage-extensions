r"""A cover whose conditions share only complex zeros is decided by the sum of their squares.

For charts cut by $\{g_i \ne 0\}$ a family covers exactly when $\bigcap_i \{g_i = 0\}$ is
empty, and the emptiness is over $\mathbb{R}$: two conditions may share a complex zero and
no real one -- $x^2 + 1$ and $y$, whose common zeros over $\mathbb{C}$ are $(\pm i, 0)$ and
which have none over $\mathbb{R}$ (Lee, *Introduction to Smooth Manifolds*, 2nd ed., Ch. 1,
for the chart domains).  The ideal certificate cannot see that, because over the algebraic
closure the ideal is not the whole ring.  One exact certificate does: if
$\sum_i g_i^2$ takes no zero, no point has every $g_i$ zero, since a sum of squares of reals
vanishes only where every term does.

The specimen is the plane with the chart cut by $x^2+1$ and the chart cut by $y$: the first
condition vanishes nowhere, so the first chart is the whole plane and the family covers it.
"""

import pytest

from sage_extensions.all import *


def _the_plane_with_two_cuts():
    r"""The plane, its chart, and the charts cut by $x^2 + 1$ and by $y$."""
    plane = SmoothManifolds()(2, "R^2")
    chart = plane.chart("U", "x y")
    x, y = chart.coordinate(0), chart.coordinate(1)
    return plane, chart, x, y, (
        plane.chart_on_open_subset("S1", "x y", "U", (x**2 + 1,)),
        plane.chart_on_open_subset("S2", "x y", "U", (y,)),
    )


def test_a_family_sharing_no_real_zero_covers_and_admits_a_section() -> None:
    r"""$x^2 + 1 \ne 0$ everywhere, so the family covers the plane although its ideal is not the whole ring.

    The ideal generated by $x^2+1$ and $y$ is not the whole polynomial ring -- the two
    share the complex zeros $(\pm i, 0)$ -- and their sum $x^2 + 1 + y$ has real roots.  The
    sum of squares $(x^2+1)^2 + y^2$ takes no zero, which is the certificate.
    """
    plane, _chart, x, _y, (never_zero, y_cut) = _the_plane_with_two_cuts()
    sections = plane.tangent_bundle().sections()

    section = sections.section(
        {
            "S1": (never_zero.function_ring().one(), never_zero.function_ring().zero()),
            "S2": (y_cut.function_ring().one(), y_cut.function_ring().zero()),
        }
    )

    assert section.parent() is sections
    assert section.components()["S2"][0](plane((0, 3))) == RR(1)
    assert section.components()["S1"][0](plane((3, 0))) == RR(1)


def test_a_family_that_shares_a_real_zero_still_does_not_cover() -> None:
    r"""The charts cut by $x$ and by $y$ share the origin, and their squares' sum $x^2 + y^2$ takes zero there."""
    plane, _chart, x, y, _cuts = _the_plane_with_two_cuts()
    sections = plane.tangent_bundle().sections()
    origin_cut = plane.atlas()["S2"]

    with pytest.raises(AssertionError):
        sections.section(
            {
                "S2": (origin_cut.function_ring().one(), origin_cut.function_ring().zero()),
            }
        )
