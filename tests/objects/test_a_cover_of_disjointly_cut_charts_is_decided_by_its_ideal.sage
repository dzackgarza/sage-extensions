r"""A cover whose cutting conditions share no zero is decided even when their sum has one.

A family of open subsets covers when no point lies outside all of them, and for charts cut
by nonvanishing conditions $\{g_i \ne 0\}$ that is $\bigcap_i \{g_i = 0\} = \varnothing$
(Lee, *Introduction to Smooth Manifolds*, 2nd ed., Ch. 1, for the chart domains).  One
certificate is that the conditions have no common zero over $\mathbb{C}$ either, which the
ideal they generate decides exactly: the ideal is the whole ring precisely then.  The sum
certificate used so far does not see this case -- $x$ and $x-1$ sum to $2x-1$, which has a
root, while the two complements cover the line.

The specimen is the line with the complements of $0$ and of $1$ cut on its chart: every
point is one of them, and neither chart contains the other.
"""

from sage_extensions.all import *


def _the_line_with_two_points_removed():
    r"""The line, its chart, and the charts on the complements of $0$ and of $1$."""
    line = SmoothManifolds()(1, "R")
    chart = line.chart("U", "x")
    x = chart.coordinate(0)
    return line, chart, x, (
        line.chart_on_open_subset("L0", "x", "U", (x,), same_coordinates=True),
        line.chart_on_open_subset("L1", "x", "U", (x + (-1),), same_coordinates=True),
    )


def test_the_complements_of_two_points_cover_the_line_and_admit_a_section() -> None:
    r"""$x \ne 0$ and $x \ne 1$ cover the line although $x + (x-1) = 2x-1$ has a root.

    The ideal generated by $x$ and $x-1$ is the whole ring, so the two conditions share no
    zero and the family covers; a section stated on both charts is admitted, and its
    component is read at each point the other chart cuts out.
    """
    line, _chart, _x, (zero_removed, one_removed) = _the_line_with_two_points_removed()
    sections = line.tangent_bundle().sections()
    zero_ring = zero_removed.function_ring()
    one_ring = one_removed.function_ring()

    section = sections.section(
        {
            "L0": (zero_ring.one(),),
            "L1": (one_ring.one(),),
        }
    )

    assert section.parent() is sections
    assert section.components()["L0"][0](line.point((RR(1),), "U")) == RR(1)
    assert section.components()["L1"][0](line.point((RR(0),), "U")) == RR(1)


def test_a_family_sharing_a_zero_still_does_not_cover() -> None:
    r"""One complement of a point does not cover the line: the point itself is missing, and the ideal it generates is not the whole ring."""
    import pytest

    line, _chart, _x, (zero_removed, _one_removed) = _the_line_with_two_points_removed()
    sections = line.tangent_bundle().sections()

    with pytest.raises(AssertionError):
        sections.section({"L0": (zero_removed.function_ring().one(),)})
