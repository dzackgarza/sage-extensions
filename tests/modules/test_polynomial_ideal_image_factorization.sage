r"""Image, kernel and cokernel of (x,y): QQ[x,y]^2 -> QQ[x,y].

The image is the ideal (x,y), the kernel is generated by (-y,x)
and the cokernel is the quotient by (x,y), with their defining maps.
Terminal-phase T supplies execution of these independent specimens.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _polynomial_linear_map():
    ring = QQ["x,y"]
    x, y = ring.algebra_generators()
    source, target = ring.free_module(2), ring.regular_module()
    a, b = tuple(source.module_generating_set())
    (one,) = tuple(target.module_generators())
    morphism = source.module_category().Mor(source, target)({
        a: target.scalar_multiple(x, one),
        b: target.scalar_multiple(y, one),
    })
    return ring, x, y, source, target, a, b, morphism


def test_polynomial_map_image_is_the_ideal_with_its_inclusion() -> None:
    ring, x, y, source, target, a, b, morphism = _polynomial_linear_map()
    ideal = morphism.image()
    inclusion = ideal.inclusion()
    epimorphism = morphism.factor_through(inclusion)

    assert ideal in CommutativeIdeals(ring)
    assert ideal in ModuleSubobjects(ring)
    assert ideal == ring.ideal(x, y)
    assert ideal is morphism.image()
    assert inclusion.domain() is ideal and inclusion.codomain() is target
    assert inclusion.is_injective() and inclusion.kernel().is_zero()
    assert epimorphism.domain() is source and epimorphism.codomain() is ideal
    assert epimorphism.is_surjective()
    assert all(
        inclusion(epimorphism(source.module_generator(label)))
        == morphism(source.module_generator(label))
        for label in (a, b)
    )
    (one,) = tuple(target.module_generators())
    assert inclusion.is_in_image(target.scalar_multiple(x, one))
    assert inclusion.is_in_image(target.scalar_multiple(y, one))
    assert inclusion.is_in_image(target.scalar_multiple(x + y, one))
    assert not inclusion.is_in_image(one)


def test_polynomial_map_kernel_is_exactly_the_principal_syzygy() -> None:
    ring, x, y, source, _target, a, b, morphism = _polynomial_linear_map()
    syzygy = source.linear_combination({a: -y, b: x})
    kernel = morphism.kernel()
    inclusion = kernel.inclusion()
    assert morphism(syzygy) == morphism.codomain().zero()
    assert inclusion.domain() is kernel and inclusion.codomain() is source
    assert inclusion.is_injective() and inclusion.kernel().is_zero()
    assert inclusion.is_in_image(syzygy)
    # The maintained polynomial-presentation kernel must supply the cyclic
    # presentation itself, rather than request a PID submodule basis over
    # the non-PID ring QQ[x,y]. A unit coefficient means the displayed
    # syzygy generates this represented cyclic kernel.
    (kernel_label,) = tuple(kernel.module_generating_set())
    coefficient = kernel.framing_morphism().lift(
        inclusion.lift(syzygy)
    )(kernel_label)
    assert coefficient.is_unit()
    # Exactly R*(-y,x): the cyclic map 1 |-> (-y,x) lands in the kernel and
    # maps onto it, so the kernel is neither larger nor smaller than the
    # principal submodule the displayed syzygy generates.
    (target_label,) = tuple(_target.module_generating_set())
    (one,) = tuple(_target.module_generators())
    cyclic = source.module_category().Mor(_target, source)({target_label: syzygy})
    induced = cyclic.factor_through(inclusion)
    assert cyclic(one) == syzygy
    assert induced.domain() is _target and induced.codomain() is kernel
    assert inclusion * induced == cyclic
    assert induced.is_surjective() and induced.kernel().is_zero()
    assert kernel.number_of_module_generators() == cardinal(1)
    # The kernel therefore *is* the submodule of R^2 generated by the syzygy:
    # the image of its own inclusion is that submodule, with the same
    # one-element basis as the image of the cyclic map 1 |-> (-y,x).
    image = inclusion.image()
    assert image in ModuleSubobjects(ring)
    assert image.inclusion().domain() is image
    assert image.inclusion().codomain() is source
    assert image.inclusion().is_injective()
    assert image.number_of_module_generators() == cardinal(1)
    assert image == cyclic.image()


def test_polynomial_map_cokernel_is_the_quotient_by_xy() -> None:
    ring, x, y, source, target, a, b, morphism = _polynomial_linear_map()
    quotient = morphism.cokernel()
    projection = morphism.cokernel_projection()
    (one,) = tuple(target.module_generators())

    assert projection.domain() is target and projection.codomain() is quotient
    assert projection.is_surjective() and projection.cokernel().is_zero()
    assert projection(target.scalar_multiple(x, one)) == quotient.zero()
    assert projection(target.scalar_multiple(y, one)) == quotient.zero()
    assert projection(one) != quotient.zero()
    assert all(
        projection(morphism(source.module_generator(label))) == quotient.zero()
        for label in (a, b)
    )
    assert ring.quotient_ring(ring.ideal(x, y)).krull_dimension() == 0

def test_polynomial_map_cokernel_has_the_universal_property() -> None:
    r"""The cokernel is $R/(x,y)$, and every map out of $R$ killing $x$ and $y$
    factors through the quotient map.

    The witness target is $R^2 / \langle (x,0), (y,0) \rangle \cong R/(x,y)
    \oplus R$: the class of $(1,0)$ is annihilated by $x$ and by $y$ but is
    nonzero, so the factorization is not the zero map.  The cokernel is
    generated by the class of $1$, so a map out of it is determined by that one
    value, which is what makes the factorization unique.
    """
    ring, x, y, source, target, a, b, morphism = _polynomial_linear_map()
    modules = Modules(ring)
    cokernel = morphism.cokernel()
    quotient = morphism.cokernel_projection()
    (one_label,) = tuple(target.module_generating_set())
    (one,) = tuple(target.module_generators())

    # The cokernel is the quotient by the ideal (x,y): its presentation matrix
    # is the row [x y] on one generator.
    assert cokernel.presentation_matrix().entries() == (x, y)
    assert cokernel.number_of_module_generators() == cardinal(1)
    assert quotient.domain() is target and quotient.codomain() is cokernel

    two_generators = ring.free_module(2)
    first_label = tuple(two_generators.module_generating_set())[0]
    first = two_generators.module_generator(first_label)
    doubled = modules.Mor(source, two_generators)(
        {
            a: two_generators.scalar_multiple(x, first),
            b: two_generators.scalar_multiple(y, first),
        }
    )
    witness = doubled.cokernel()
    witness_quotient = doubled.cokernel_projection()
    first_factor = modules.Mor(target, two_generators)({one_label: first})
    out = witness_quotient * first_factor
    assert out(one) != witness.zero()
    assert out(morphism(source.module_generator(a))) == witness.zero()
    assert out(morphism(source.module_generator(b))) == witness.zero()

    zero_map = modules.Mor(source, target)(lambda element: target.zero())
    construction = modules.coequalizer_construction(morphism, zero_map)
    shape = construction.diagram().domain()
    cocone = construction.diagram().Cocones().cocone(
        witness,
        lambda index: out if index is shape.target() else zero_map,
    )
    factorization = construction.factor(cocone).apex_map()
    assert factorization.codomain() is witness
    assert factorization(quotient(one)) == out(one)
    assert factorization(quotient(one)) != witness.zero()
