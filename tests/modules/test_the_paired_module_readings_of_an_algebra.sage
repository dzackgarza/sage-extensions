r"""The paired readings of one algebra: the carrier, and its separate scalar view.

A polynomial quotient ``A = QQ[x]/(x^2)`` is one parent — its elements are the
classes, with their coefficient data — and two module readings of it:

* over its cover, the cyclic generating family with the ideal's relations, which
  is *not* free, so ``ZZ/2`` over ``ZZ`` keeps refusing the projective placement;
* over its coefficient ring, the separate parent
  ``RestrictedScalarsModules(QQ)(A, coefficient_composite)``, whose frame is the
  quotient's own retained power basis and whose relations are the regular
  module's (none).

This file states both, that the algebra parent is unchanged by either, and where
they differ.  It does not restate the kernel of the fat-point projection, which
is tracked in ``TRAPS.md``.
"""

from sage_extensions.all import *  # noqa: F401,F403
from sage_extensions.categories.algebras.algebras import (
    Algebras,
    AlgebrasWithChosenFinitePresentation,
)
from sage_extensions.categories.modules.framed.framed_free_modules import (
    FramedFreeModules,
)
from sage_extensions.categories.modules.pure.modules import (
    Modules,
    ModulesWithChosenFinitePresentation,
    RestrictedScalarsModules,
)
from sage_extensions.refine import refine

import pytest


def _specimens():
    r"""``A = QQ[x]/(x^2)``, its cover, its coefficient composite and its view."""
    polynomials = QQ["x"]
    x = polynomials.gen()
    algebra = polynomials.quotient_ring(x**2)
    coefficient_composite = (
        algebra.quotient_map() * polynomials.algebra_structure_morphism()
    )
    return polynomials, algebra, coefficient_composite


def test_the_quotient_parent_is_unchanged_by_reading_it_over_the_coefficient_ring() -> None:
    r"""The carrier keeps its base ring, its elements and its class."""
    polynomials, algebra, coefficient_composite = _specimens()
    quotient_source = algebra.quotient_source()
    defining_ideal = algebra.defining_ideal()

    _reading = RestrictedScalarsModules(QQ)(algebra, coefficient_composite)

    assert algebra.base_ring() is polynomials
    assert algebra(0).parent() is algebra
    assert algebra.quotient_source() is quotient_source
    assert algebra.defining_ideal() == defining_ideal
    assert algebra.one() == algebra(1)


def test_the_separate_scalar_reading_has_the_retained_frame_and_presentation() -> None:
    r"""Two generators from the quotient's power basis, and no relations."""
    _polynomials, algebra, coefficient_composite = _specimens()
    reading = RestrictedScalarsModules(QQ)(algebra, coefficient_composite)

    assert reading is not algebra
    assert reading.base_ring() is QQ
    assert reading.module_over_extension() is algebra
    assert reading.module_generating_set().cardinality() == 2
    assert reading in ModulesWithChosenFinitePresentation(QQ)


def test_the_reading_over_the_cover_is_cyclic_and_not_a_basis() -> None:
    r"""Over its cover the quotient is generated by the class of ``1``, with the ideal as relations."""
    polynomials, algebra, _coefficient_composite = _specimens()
    x = polynomials.gen()

    assert algebra.module_category() == Modules(polynomials)
    assert algebra.module_generating_set().cardinality() == 1
    labels = algebra.module_generating_set()
    assert algebra.module_generator(next(iter(labels))) == algebra.one()
    assert algebra.defining_ideal().ideal_generators().index_set().cardinality().is_finite() is True


def test_the_two_readings_are_not_the_same_parent() -> None:
    r"""``A`` over ``A`` and ``A`` over ``QQ`` are distinct; neither replaces the other."""
    _polynomials, algebra, coefficient_composite = _specimens()
    reading = RestrictedScalarsModules(QQ)(algebra, coefficient_composite)

    assert reading is not algebra
    assert (algebra in ModulesWithChosenFinitePresentation(QQ)) is False
    assert reading in ModulesWithChosenFinitePresentation(QQ)


def test_one_generator_over_the_cover_still_does_not_make_the_quotient_projective() -> None:
    r"""``ZZ/2`` has the single generator ``1`` over ``ZZ`` and is not projective.

    ``projectivity_decision()`` answers for the reading the caller asks about —
    ``Modules(ZZ)`` here — so it never certifies this ring as projective.  The
    separate reading above is a different parent and does not change that.
    """
    residues = ZZ.quotient_ring(ZZ.ideal(2))

    assert residues.has_selected_module_resolution() is True
    assert residues.module_generating_set().cardinality() == 1
    with pytest.raises(ValueError):
        refine(residues, FramedFreeModules(ZZ).FinitelyGenerated())


def test_the_restricted_frame_answers_its_pair_labelled_generators() -> None:
    r"""``module_generator`` on a pair label is the retained basis image ``s_i m_j``.

    The framing labels of ``Res_f(M)`` are pairs — a label of the scalar basis and
    a generator of ``M`` — and the generator map must read them as such: the image
    is the action of the scalar on the module generator, which for the regular
    reading is the extension ring's own multiplication.  Reading it through the
    *coefficient* action instead converts a class where a polynomial is expected,
    which is what this pins.
    """
    polynomials, algebra, coefficient_composite = _specimens()
    x = polynomials.gen()
    reading = RestrictedScalarsModules(QQ)(algebra, coefficient_composite)
    labels = reading.module_generating_set()

    assert labels.cardinality() == 2
    images = tuple(reading.module_generator(label) for label in labels)
    assert images[0].underlying_element() == algebra.one()
    assert images[1].underlying_element() == algebra(x)


def test_the_restricted_reading_has_the_zero_relation_morphism() -> None:
    r"""The regular reading has no relations, so its relation source is empty."""
    _polynomials, algebra, coefficient_composite = _specimens()
    reading = RestrictedScalarsModules(QQ)(algebra, coefficient_composite)

    relations = reading.presentation()
    assert relations.domain().module_generating_set().cardinality() == 0
