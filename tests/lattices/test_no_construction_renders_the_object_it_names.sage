r"""A construction stores the object it is named after and renders none of it.

A shell is named after the lattice it is cut out of, a row of orbit
representatives after the lattice or the subgroup whose orbits they are, an
enumeration of discriminant subgroups after the module, and a fixed locus after
the isometry and the set it acts on.  Building one of those keeps that name and
computes nothing from it: the name is rendered when a reader asks, which is the
rule the finite ordered sets keep.  So each construction below is built with the
display of the object it names refused; a construction that rendered it fails at
the site that asked, and one that did not returns its object, whose mathematics
the test then asserts.

Every number asserted is derived from the specimen, not read off the
construction:

- On the rank-one lattice \(\langle 2\rangle\) the vectors of square \(2\) are
  the two satisfying \(2x^2 = 2\), namely \(\pm e\).
- \(\mathbf Z^3\) is the odd unimodular lattice of rank three, its genus is one
  class, the discriminant group is trivial, and the spinor genus is the class,
  so the spinor-genus class numbers are \((1)\).
- \(O(\langle 2\rangle) = \{\pm 1\}\): the identity and the negation, so one
  generator, acting as \(-1\).
- For \(L = \langle 2\rangle \oplus \langle 2\rangle\) the discriminant group is
  \((\mathbf Z/2)^2\) with \(b(x,y) = (x_1y_1 + x_2y_2)/2\) modulo \(1\).  The
  nonzero classes have \(b(x,x) = 1/2\), except \((1,1)\), which has
  \(b((1,1),(1,1)) = 1\); so the bilinear-isotropic subgroups are \(0\) and
  \(\langle(1,1)\rangle\), and Nikulin's correspondence gives two overlattices,
  of determinants \(4\) and \(1\).
- \(A_{\langle 2\rangle} = \mathbf Z/2\) with \(q(1) = 1/2\), so no nonzero
  subgroup is isotropic: one isotropic subgroup, the zero one.
- On \(U\), \(O(U)\) preserves the content and is transitive on the primitive
  isotropic vectors, so the square-zero orbits are the contents, of which there
  are infinitely many, and the representatives are \(0\), then \(c\) times a
  primitive isotropic vector.
- \(L = U \oplus \langle 2\rangle\) has \(A_L = \mathbf Z/2\) with
  \(q(1) = 1/2\), so a primitive isotropic \(v\) has \(v/2\) a class of order
  two and square \(1/2\), which is impossible: every primitive isotropic vector
  of \(L\) has divisibility one, and the Eichler criterion in a lattice
  containing \(U\) puts them in one orbit of the stable orthogonal group.
- A \(G\)-set with the trivial action has \(X^g = X\) for every \(g\).
"""

from sage_extensions.all import *  # noqa: F401,F403


def test_a_square_shell_stores_the_lattice_it_is_named_after_and_renders_none() -> None:
    r"""The vectors of square \(2\) in \(\langle 2\rangle\) are \(\pm e\)."""
    lattice = Lattices(ZZ)([[2]])
    shell = built_without_display(lattice, lambda: lattice.vectors_of_square(2))
    (generator,) = tuple(lattice.module_generators())

    assert shell.cardinality() == cardinal(2)
    assert all(lattice.q(point) == 2 for point in shell)
    assert all(point == generator or point == -generator for point in shell)


def test_the_spinor_genus_class_numbers_are_stored_without_rendering_the_lattice() -> None:
    r"""\(\mathbf Z^3\) is the odd unimodular rank-three lattice: one class number."""
    lattice = Lattices(ZZ)([[1, 0, 0], [0, 1, 0], [0, 0, 1]])
    numbers = built_without_display(lattice, lambda: lattice.spinor_genus_class_numbers())

    assert tuple(numbers) == (1,)


def test_the_orthogonal_group_generators_store_their_lattice_unrendered() -> None:
    r"""\(O(\langle 2\rangle) = \{\pm 1\}\) is generated by the negation."""
    lattice = Lattices(ZZ)([[2]])
    negations = built_without_display(lattice, lambda: lattice.O().group_generators())
    (negation,) = tuple(negations)
    (generator,) = tuple(lattice.module_generators())

    assert negation(generator) == -generator


def test_the_overlattice_inclusions_store_their_lattice_unrendered() -> None:
    r"""Two gluings in \(\langle 2\rangle \oplus \langle 2\rangle\): determinant \(4\) and \(1\)."""
    lattice = Lattices(ZZ)([[2, 0], [0, 2]])
    inclusions = built_without_display(lattice, lambda: lattice.integral_overlattice_inclusions())

    assert inclusions.cardinality() == cardinal(2)
    assert sorted(int(inclusion.codomain().determinant()) for inclusion in inclusions) == [1, 4]


def test_the_isotropic_subgroups_of_a_discriminant_module_store_it_unrendered() -> None:
    r"""\(A_{\langle 2\rangle} = \mathbf Z/2\) with \(q(1) = 1/2\): one isotropic subgroup."""
    module = Lattices(ZZ)([[2]]).discriminant_module()
    subgroups = built_without_display(module, lambda: module.isotropic_subgroups())

    assert subgroups.cardinality() == cardinal(1)
    assert all(subgroup.cardinality() == cardinal(1) for subgroup in subgroups)


def test_the_square_zero_orbits_of_a_hyperbolic_plane_store_their_lattice_unrendered() -> None:
    r"""\(O(U)\) is transitive on primitive isotropic vectors: the orbits are the contents."""
    lattice = Lattices(ZZ)("U")
    representatives = built_without_display(
        lattice, lambda: lattice.O().vector_orbit_representatives(0)
    )
    listed = representatives.enumeration()

    assert representatives.cardinality().is_finite() is False
    assert listed(NN(0)) == lattice.zero()
    assert all(lattice.q(listed(NN(index))) == 0 for index in (1, 2))
    assert tuple(int(listed(NN(index)).content()) for index in (1, 2)) == (1, 2)


def test_the_fixed_locus_of_an_isometry_stores_what_it_names_and_renders_none() -> None:
    r"""On the trivial \(G\)-set on two points, \(X^g = X\) for every \(g\)."""
    lattice = Lattices(ZZ)([[2]])
    group = lattice.O()
    (isometry,) = tuple(group.group_generators())
    action = FiniteGSets(group)(Sets.Δ[1], lambda generator, point: point)

    fixed = built_without_display(isometry, lambda: action.fixed_subobject_of(isometry))

    assert fixed.cardinality() == cardinal(2)


def test_a_character_kernel_subgroup_stores_its_square_zero_row_unrendered() -> None:
    r"""The stable orthogonal group of \(U \oplus \langle 2\rangle\) acts on square-zero vectors."""
    lattice = Lattices(ZZ)("U") + Lattices(ZZ)([[2]])
    subgroup = lattice.stable_orthogonal_group()

    representatives = built_without_display(
        subgroup, lambda: subgroup.vector_orbit_representatives(0)
    )
    listed = representatives.enumeration()

    assert representatives.cardinality().is_finite() is False
    assert listed(NN(0)) == lattice.zero()
    assert all(lattice.q(listed(NN(index))) == 0 for index in (1, 2))
    assert tuple(int(listed(NN(index)).content()) for index in (1, 2)) == (1, 2)
