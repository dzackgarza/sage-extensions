r"""The setwise stabilizer's generators at Sterk's $P_2$ of $T_{\mathrm{En}}$ carry the radical (#366).

The public call is `L.Aut().stabilizer(P, action="setwise").group_generators()`, and what
it returns is a generating family of $P_I = \mathrm{Stab}_{O(L)}(P)$: the block-equation
family of the parabolic, whose three factors are the unipotent radical, the Levi factor on
$P^\perp/P$ and the Levi factor on $P$, and which is the whole parabolic there because all
three factors are settled (`parabolic_completeness_decision`).

The unipotent radical $U_I = \ker(P_I \to \GL(P) \times O(P^\perp/P))$ is generated by the
family of `unipotent_radical_block_generators()` -- one element over each vector of the
parameter lattice $\tau(U_I)$, plus a generator of the centre $Z$ (#365) -- and every one
of those elements lies in $P_I$ and in each of its pointwise subgroups, so the call's
family must carry them.

This file pins four computed facts, all through that call: the family is non-empty; it
contains every one of the radical's block generators and the centre's generator; its
members that lie in the radical translate in every direction of $\tau(U_I)$, compared with
the rank the radical's translation image has; and one of its members is a *generator* of
$Z$, its coordinate on the centre's generator having absolute value one.

The identifications are the radical's own: a member of $P_I$ lies in $U_I$ exactly when it
fixes $P_2$ pointwise and acts trivially on $P_2^\perp/P_2$, and it lies in the centre
exactly when it fixes $P_2^\perp$ pointwise.  Milne, *Group Theory*, v4.01, Theorem 1.47
(Correspondence Theorem), printed p. 22, with Corollary 1.48 on p. 23, is what turns
"generates modulo the centre and contains a generator of the centre" into "generates", and
it is cited in `unipotent_radical_block_generators`.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _second_representative(lattice):
    r"""Sterk's $P_2$: the plane that does not split off $T_{\mathrm{En}}$."""
    basis_elements = list(lattice.module_generators())
    first, second, third = basis_elements[0], basis_elements[1], basis_elements[2]
    w = basis_elements[4] + basis_elements[5]
    return lattice.primitive_isotropic_subobject(2 * first + 2 * second + w, third)


def _plane_basis(plane):
    r"""The plane's own basis, taken from its inclusion."""
    return tuple(
        plane.inclusion()(plane.module_generator(label))
        for label in plane.module_generating_set()
    )


def _perpendicular_basis(plane):
    r"""A generating set of $P_2^\perp$, in the ambient lattice."""
    perpendicular = plane.isotropic_perpendicular()
    return tuple(
        perpendicular.inclusion()(perpendicular.module_generator(label))
        for label in perpendicular.module_generating_set()
    )


def test_the_stabilizer_generators_carry_a_generating_family_of_the_radical() -> None:
    r"""The public family contains the radical's generators, reaches $\tau(U_I)$, and meets $Z$ in a generator.

    One call, four comparisons.  The containment is membership of each element of
    `unipotent_radical_block_generators()` and of the centre's generator in the returned
    family.  The translation rank is that of the family's members that fix the plane
    pointwise and act trivially on $P_2^\perp/P_2$ -- the radical's definition, decided on
    the plane's own basis and by the reduction's own test -- against the rank
    $2 \operatorname{rank}(P_2^\perp/P_2)$ the radical's translation image has.  And the
    centre is met in a generator: the members that fix $P_2^\perp$ pointwise are the central
    ones, and one of them has coordinate $\pm 1$ on the centre's generator.
    """
    plane = _second_representative(NamedLattices.TEn)
    lattice = plane.ambient_lattice()
    family = tuple(
        lattice.Aut().stabilizer(plane, action="setwise").group_generators()
    )
    radical = tuple(plane.unipotent_radical_block_generators())
    basis = _plane_basis(plane)

    assert family != ()
    assert radical != ()
    assert cardinal(sum(1 for element in radical if element in family)) == cardinal(
        sum(1 for _ in radical)
    )
    assert plane.unipotent_central_generator() in family

    members = tuple(
        element
        for element in family
        if all(element(vector) == vector for vector in basis)
        and plane.acts_trivially_on_isotropic_reduction(element)
    )
    assert members != ()
    translation, target = plane.unipotent_translation_rank(members)
    assert cardinal(translation) == cardinal(target)
    assert cardinal(target) == cardinal(
        plane.unipotent_radical_rank() - plane.unipotent_translation_kernel_rank()
    )

    perpendicular = _perpendicular_basis(plane)
    central = tuple(
        element
        for element in members
        if all(element(vector) == vector for vector in perpendicular)
    )
    assert central != ()
    assert any(
        abs(plane.unipotent_central_coordinate(element)) == cardinal(1)
        for element in central
    )
