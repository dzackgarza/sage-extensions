r"""The Schreier factors rebuild the stabilizer's generating family, element for element.

A stabilizer reached through an orbit is generated by Schreier's family
``t_(s.p)^-1 s t_p`` over the orbit points ``p`` and the selected letters ``s``.
Realizing that family means evaluating ``|orbit| * |letters|`` words; the
factors ``(letters, transversals)`` carry the same information in
``|orbit| + |letters|`` elements, and every family element is then the
three-term composite of elements a caller already holds.

The certificate is the composite law itself, checked elementwise against the
family the provider builds: for the ``i``-th orbit point and the ``j``-th letter
the family element at the same position is
``~transversals[position of s.p] * letters[j] * transversals[i]``.  Equal orders
would not identify the family; this comparison does.

Both layers carry the law, and both are asserted here on specimens this
repository's own tests build: the integral-structure action of
``tests/lattices/test_integral_stabilizers.sage``, and the natural action of the
finite group ``tests/groups/test_schreier_generating_morphisms.sage`` builds.
The second is the same law one owner lower, where the factors are the G-set's
own datum rather than the action's.

The Coble point stabilizer of
``tests/lattices/test_coble_point_stabilizer_generators.sage`` is measured rather
than asserted: its 496-point orbit needs about 325 s for the factors alone, so
materializing both sides of the comparison is out of reach of this suite's
per-test bound (``--timeout=60``).  The order certificate for that specimen is
#273's, and the measurements are recorded in ``TRAPS.md``.
"""

from sage_extensions.all import *  # noqa: F401,F403

import pytest


def _rational_space(lattice_):
    r"""``lattice_`` read in the rational space ``Res_{ZZ}^{QQ}`` of its plane."""
    return Modules(QQ).restriction_of_scalars(ZZ.Mor(QQ)(lambda n: QQ(n)))(lattice_)


def test_the_action_factors_compose_to_its_stabilizer_family() -> None:
    r"""``IntegralStructureAction`` on ``U``: the factors and the family agree elementwise."""
    plane = Lattices(QQ)("U")
    space = _rational_space(plane)
    labels = plane.module_generating_set()
    basis = [plane.module_generator(label) for label in labels]
    orthogonal_group = plane.Aut()
    swap = orthogonal_group(lambda label: basis[1 - int(label)])
    lattice = space.subobject_on([space(vector) for vector in basis])
    action = IntegralStructureAction(orthogonal_group.subgroup((swap,)), lattice.inclusion())

    letters, transversals = action.stabilizer_schreier_factors()
    family = tuple(action.stabilizer().group_generators())

    points = tuple(action.right_cosets())
    positions = {point: position for position, point in enumerate(points)}
    rebuilt = []
    for position, point in enumerate(points):
        for letter in letters:
            image = positions[action.right_cosets().act(letter, point)]
            rebuilt.append((~transversals[image]) * letter * transversals[position])
    assert tuple(rebuilt) == family


def test_the_natural_g_set_factors_compose_to_its_stabilizer_family() -> None:
    r"""``Groups.S(3)`` on its three points: the same law at the G-set owner.

    The factors are the G-set's own datum -- ``orbit_schreier_factors`` returns
    them there and the action merely passes them up -- so the law is asserted at
    both layers rather than only where it is consumed.  Two assertions, and both
    are about the mathematics: every composite fixes the point, and the family
    the stabilizer presents is the composite family element for element.
    """
    group = Groups.S(3)
    action = group.natural_g_set()
    points = tuple(action)
    point = points[0]

    letters, transversals = action.orbit_schreier_factors(point)
    family = tuple(action.stabilizer(point).group_generators())

    positions = {candidate: position for position, candidate in enumerate(points)}
    rebuilt = tuple(
        (~transversals[positions[action.act(letter, candidate)]]) * letter * transversals[position]
        for position, candidate in enumerate(points)
        for letter in letters
    )

    assert all(composite(point) == point for composite in rebuilt)
    assert rebuilt == family


@pytest.mark.parametrize("scaled", (False, True), ids=("two_u", "scaled_hyperbolic_line"))
def test_the_isotropic_lattice_stabilizer_factors_give_the_full_family(scaled):
    r"""The line stabilizers in 2U and U(4)+<-8> retain every Schreier element.

    The latter has a nonintegral unipotent action and a lattice orbit of
    order two. Its square is integral. The invariant containing lattice
    adds ``e/4+w/2`` to the original integral span.
    """
    if scaled:
        plane = Lattices(QQ)([[0, 4, 0], [4, 0, 0], [0, 0, -8]])
        e, f, w = tuple(plane.module_generators())
        quarter = QQ(1) / QQ(4)
        half = QQ(1) / QQ(2)
        extra = plane.scalar_multiple(quarter, e) + plane.scalar_multiple(half, w)
        images = ((e, f, -w), (-e, -f, w), (e, f + extra, e + w))
        expected = 6
    else:
        plane = Lattices(QQ)("U") + Lattices(QQ)("U")
        e, f, u, v = tuple(plane.module_generators())
        images = (
            (e, f, u, v), (e, f, -u, -v),
            (e, f, v, u), (e, f, -v, -u),
            (-e, -f, u, v), (e, f - v, u + e, v), (e, f - u, u, v + e),
        )
        expected = 7
    space = _rational_space(plane)
    basis = tuple(plane.module_generators())
    lattice = space.subobject_on(tuple(space(point) for point in basis))
    bound = (
        space.subobject_on((*tuple(space(point) for point in basis), space(extra)))
        if scaled else lattice
    )
    group_generators = tuple(plane.O()(family) for family in images)
    assert all(
        plane.b(generator(left), generator(right)) == plane.b(left, right)
        for generator in group_generators for left in basis for right in basis
    )
    group = plane.O().subgroup(group_generators)
    action = IntegralStructureAction(group, lattice.inclusion()).with_stable_containing_bound(bound.inclusion())
    action.validate_stable_containing_bound(check=True)

    letters, transversals = action.stabilizer_schreier_factors()
    family = action.stabilizer().group_generators()
    cosets = action.right_cosets()
    points = tuple(cosets)
    positions = {point: position for position, point in enumerate(points)}
    rebuilt = tuple(
        (~transversals[positions[cosets.act(letter, point)]]) * letter * transversals[position]
        for position, point in enumerate(points)
        for letter in letters
    )

    assert family.cardinality() == cardinal(expected)
    assert rebuilt == tuple(family)
