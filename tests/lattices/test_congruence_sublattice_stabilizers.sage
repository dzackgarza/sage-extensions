r"""Exact setwise stabilizers of sublattices in the actual finite O(L)-image (#42).

For U=Ze+Zf with e.f=1, the orthogonal group has the four elements
{I,-I,S,-S}, S exchanging e and f. For any m>1 the image of Ze in
U/mU is preserved by exactly {I,-I}; the image of Z(e+f) is preserved
by all four. These are submodule stabilizers, not stabilizers of the
individual vector e (the latter is trivial modulo 6). In particular
nonprimitive source embeddings must retain their content modulo m.
"""

from sage_extensions.all import *


def _hyperbolic_data():
    plane = Lattices(ZZ)("U")
    e, f = tuple(plane.module_generators())
    labels = tuple(plane.module_generating_set())
    negation = plane.O()({label: -plane.module_generator(label) for label in labels})
    exchange = plane.O()(dict(zip(labels, (f, e), strict=True)))
    return plane, e, f, negation, exchange


def test_mod_six_line_stabilizers_use_the_image_of_the_original_orthogonal_group():
    plane, e, f, negation, exchange = _hyperbolic_data()
    group = plane.O()
    axis = plane.subobject_on((e,)).inclusion()
    diagonal = plane.subobject_on((e+f,)).inclusion()
    axis_stabilizer = group.congruence_sublattice_stabilizer(6, axis)
    assert axis_stabilizer.cardinality() == cardinal(2)
    assert group.one() in axis_stabilizer and negation in axis_stabilizer
    assert exchange not in axis_stabilizer
    assert group.congruence_vector_stabilizer(6, e).cardinality() == cardinal(1)
    diagonal_stabilizer = group.congruence_sublattice_stabilizer(6, diagonal)
    assert diagonal_stabilizer.cardinality() == cardinal(4)
    assert all(generator in diagonal_stabilizer for generator in group.group_generators())


def test_nonprimitive_source_has_the_correct_mod_two_and_mod_six_stabilizers():
    plane, e, _f, negation, exchange = _hyperbolic_data()
    group = plane.O()
    twice_axis = plane.subobject_on((2*e,)).inclusion()
    # The submodule generated by 2e vanishes modulo 2.
    full = group.congruence_sublattice_stabilizer(2, twice_axis)
    assert full.cardinality() == cardinal(4)
    assert exchange in full
    # Modulo 6 it is the order-three axis subgroup, distinct from 2Z f.
    proper = group.congruence_sublattice_stabilizer(6, twice_axis)
    assert proper.cardinality() == cardinal(2)
    assert negation in proper and exchange not in proper


def test_large_composite_modulus_needs_only_the_submodule_orbit():
    plane, e, _f, negation, exchange = _hyperbolic_data()
    # U/1001U has 1001^2 elements, but the orbit of the rank-one axis
    # subgroup under O(U) has exactly two members: Ze and Zf modulo 1001.
    gamma = plane.O().congruence_sublattice_stabilizer(
        1001, plane.subobject_on((e,)).inclusion()
    )
    assert gamma.cardinality() == cardinal(2)
    assert negation in gamma and exchange not in gamma


def test_rank_two_nonfree_composite_residue_and_change_of_generators():
    r"""The submodule <2e,3f> of U/6U has order 6, but is not free over Z/6.

    Interchanging e and f does not preserve its two different cyclic
    coordinate subgroups, whereas negation does. Replacing 2e by 2e+3f
    changes its chosen generators but not the submodule or its stabilizer.
    """
    plane, e, f, negation, exchange = _hyperbolic_data()
    group = plane.O()
    original = plane.subobject_on((2*e, 3*f)).inclusion()
    changed = plane.subobject_on((2*e+3*f, 3*f)).inclusion()
    for marked in (original, changed):
        stabilizer = group.congruence_sublattice_stabilizer(6, marked)
        assert stabilizer.cardinality() == cardinal(2)
        assert group.one() in stabilizer and negation in stabilizer
        assert exchange not in stabilizer
        assert all(g in stabilizer for g in stabilizer.group_generators())


def test_unimodular_isotropic_plane_residue_stabilizer_contains_integral_shears():
    r"""For 2U, the Eichler shear u->u+e fixes the maximal null plane <e,u>.

    The isometry e<->f does not preserve that plane even modulo three.
    The defining predicate uses the entire image submodule, not a chosen
    ordered basis, so the shear is included despite moving u.
    """
    hyperbolic = Lattices(ZZ)("U")
    lattice = hyperbolic + hyperbolic
    group = lattice.O()
    e, f, u, v = tuple(lattice.module_generators())
    labels = tuple(lattice.module_generating_set())
    shear = group(dict(zip(labels, (e, f-v, u+e, v), strict=True)))
    swap = group(dict(zip(labels, (f, e, u, v), strict=True)))
    inclusion = lattice.primitive_isotropic_subobject(e, u).inclusion()
    stabilizer = group.congruence_sublattice_stabilizer(3, inclusion)
    assert shear in stabilizer and swap not in stabilizer
    assert shear(u) != u


def test_unit_level_stabilizes_every_sublattice_without_a_zero_ring_group():
    r"""L/L is zero, hence the stabilizer is O(L), including a nonprimitive line."""
    plane, e, _f, negation, exchange = _hyperbolic_data()
    group = plane.O()
    gamma = group.congruence_sublattice_stabilizer(1, plane.subobject_on((2*e,)).inclusion())
    assert gamma is group
    assert negation in gamma and exchange in gamma
