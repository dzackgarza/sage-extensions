r"""Primitive vectors with a prescribed square and complement, one per ``O(T)``-orbit.

The fibre ``{delta in T : delta primitive, delta^2 = d, delta^perp = C}`` is
infinite in an indefinite ``T``, so it is never enumerated.  By Nikulin
(Prop. 1.15.1 and 1.5.1) its ``O(T)``-orbits are the primitive embeddings
``<d> perp C -> T`` of finite index, i.e. the gluing data of the overlattices of
``<d> perp C``, collapsed by ``O(<d>) x O(C)``.

Each test below decides one item of the issue's acceptance on the smallest input
that decides it, and the definite controls are the positive definite forms.
``A2`` is card `0012`'s own lattice, so its expected count is the card's ``O``
row at norm two with nothing relabelled; the other controls compare the
operation's count with the number of orbits of the enumerated fibre under the
lattice's own simple reflections and negation, which is the enumeration reduced
modulo ``O(T)`` and not a number typed here.  The consumer is the Enriques
lattice ``T_En`` with ``square = -2`` and complement ``T_Co`` (Dolgachev--Kondo,
Izv. Math. 77:3 (2013), section 3 equation (3.6), printed p. 513), whose gluing
has index two and whose count is Namikawa's -- see that test.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _coordinates(vector, labels):
    r"""The coordinates of ``vector`` along the module generators ``labels``."""
    coordinates = vector.to_vector()
    return tuple(int(coordinates(label)) for label in labels)


def _definite_control(name):
    r"""The positive definite root lattice ``name`` and the complement of a root."""
    lattice = Lattices(ZZ)(name).twist(-1)
    root = lattice.module_generators()[0]
    return lattice, root, lattice.orthogonal_complement(lattice.subobject_on([root]))


def _simple_reflections(lattice):
    r"""The reflections ``x |-> x - b(x, a) a`` at the module generators ``a``.

    ``a`` is a root of square two in the positive definite controls these
    helpers serve, so its own square is ``b(a, a) = 2`` and the reflection is
    ``x - (2 b(x, a) / b(a, a)) a = x - b(x, a) a``.  The sign is the lattice's:
    the same expression with ``+`` is the reflection at a root of square ``-2``.
    """
    family = lattice.Aut()

    def reflection(alpha):
        def image(label):
            vector = lattice.module_generator(label)
            return vector - lattice.b(vector, alpha) * alpha

        return family(image)

    return tuple(
        reflection(lattice.module_generator(label)) for label in lattice.module_generating_set()
    )


def _enumerated_orbit_count(lattice, vectors, actions=()):
    r"""The number of orbits of the enumerated ``vectors`` under ``actions`` and the negation.

    The group generated by the simple reflections and the negation is ``O(T)``
    for an irreducible root lattice, and the controls that are not irreducible
    supply the permutations of their isometric summands here, since those are
    isometries the reflections do not generate.  The partition is computed from
    the enumerated vectors alone: no vector the operation returned is a seed,
    which is what makes this a control and not a restatement.
    """
    labels = tuple(lattice.module_generating_set())
    moves = tuple(actions) + _simple_reflections(lattice)
    seen = []
    orbits = []
    for vector in vectors:
        if _coordinates(vector, labels) in seen:
            continue
        orbit = [vector]
        frontier = [vector]
        while frontier:
            current = frontier.pop()
            for image in [move(current) for move in moves] + [-current]:
                if _coordinates(image, labels) not in [
                    _coordinates(member, labels) for member in orbit
                ]:
                    orbit.append(image)
                    frontier.append(image)
        orbits.append(orbit)
        seen.extend(_coordinates(member, labels) for member in orbit)
    return sum(1 for _orbit in orbits)


def test_the_certificate_is_an_isometry_from_the_lattice_to_an_even_overlattice() -> None:
    r"""Item 1: the certificate's direction, the vector it carries, and its index.

    The issue asks for the realizing isometry ``T -> L`` carrying ``delta`` to
    ``L``'s generator of the ``<d>`` summand, so the returned isometry must have
    the lattice as its domain and must carry ``delta`` onto a primitive vector of
    the prescribed square in the overlattice.  The index is
    ``|A_<d> perp A_C|^(1/2) / |A_T|^(1/2)``, read from the two cardinalities
    the library computes, and ``L``'s own discriminant order makes exactly that
    index: ``|A_L| * index^2 = |A_<d> perp C|``.

    The count is the card's and not the operation's: card `0012` is ``A2``, whose
    gram is this positive definite specimen, and its ``O`` row is the orbit
    series of primitive vectors by square, so ``z[1]`` is the number of
    ``O``-orbits of square two.  The card's own gram is carried through
    ``is_isometric_to`` first, so the expected number is read from the card this
    lattice is, not from a series of some other lattice.
    """
    lattice, _root, complement = _definite_control("A2")
    specification = card("primitive_orbit_series", "0012")
    assert Lattices(ZZ)(specification["gram"]).is_isometric_to(lattice) is True
    expected = specification["rows"]["O"]["z"][1]

    pair_order = int((Lattices(ZZ)([[2]]) + complement).discriminant_group().cardinality())
    lattice_order = int(lattice.discriminant_group().cardinality())
    assert pair_order % lattice_order == 0
    index_squared = pair_order // lattice_order
    assert ZZ(index_squared).is_square() is True
    index = ZZ(index_squared).sqrt()

    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == expected
    delta, isometry = found[0]

    assert delta.q() == ZZ(2)
    assert lattice.subobject_on([delta]).is_primitive() is True
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([delta]))
    ) is True

    assert isometry.domain() is lattice
    overlattice = isometry.codomain()
    assert overlattice.is_even() is True
    assert int(overlattice.discriminant_group().cardinality()) * index**2 == pair_order

    generator = isometry(delta)
    assert generator.q() == ZZ(2)
    assert overlattice.subobject_on([generator]).is_primitive() is True


def test_the_definite_control_agrees_with_the_card_row_of_its_orbits() -> None:
    r"""Item 2: card `0012`'s ``O`` count at norm two, and the enumeration's own count.

    The card's ``A2`` is the positive definite form ``[[2, -1], [-1, 2]]``, which
    is this test's lattice, so its ``z`` row is the row of the square ``2`` with
    no sign to relabel.
    """
    lattice, root, complement = _definite_control("A2")
    row = card("primitive_orbit_series", "0012")["rows"]["O"]

    fibre = tuple(lattice.vectors_of_square_and_divisibility(ZZ(2), root.div()))
    assert fibre
    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == row["z"][1]
    assert sum(1 for _entry in found) == _enumerated_orbit_count(lattice, fibre)


def test_a_rank_one_complement_of_order_two_collapses_by_its_own_negation() -> None:
    r"""Item 2 on ``<2> perp <2>``: the complement's negation is the identity.

    ``A_<2>`` has order two, so the only class it carries is its own negation and
    the collapse by ``O(C) = {+-1}`` -- which is ``rho_C(O(C))`` for a rank one
    ``C`` -- is the identity.  The enumerated fibre is four vectors and the
    operation owes one vector per ``O(T)``-orbit, counted from the enumeration.
    """
    lattice = Lattices(ZZ)([[-2, 0], [0, -2]]).twist(-1)
    complement = Lattices(ZZ)([[2]])
    root = lattice.module_generators()[0]
    assert int(complement.discriminant_quadratic_form().cardinality()) == 2
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([root]))
    ) is True

    labels = tuple(lattice.module_generating_set())
    first, second = (lattice.module_generator(label) for label in labels)

    def transposition(label):
        return second if label == labels[0] else first

    swap = lattice.Aut()(transposition)

    fibre = tuple(lattice.vectors_of_square_and_divisibility(ZZ(2), root.div()))
    assert fibre
    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == _enumerated_orbit_count(lattice, fibre, (swap,))
    delta, _isometry = found[0]
    assert delta.q() == ZZ(2)
    assert lattice.subobject_on([delta]).is_primitive() is True
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([delta]))
    ) is True


def test_a_definite_complement_of_rank_two_is_collapsed_by_its_own_image() -> None:
    r"""Item 2 at a complement of rank two: ``A3`` and the complement of a root.

    The complement is rank two with determinant eight, and its discriminant form
    has order eight with invariant factors ``(2, 4)``: neither elementary nor
    indefinite, so the collapse there is by the image of ``O(C)`` itself.
    """
    lattice, root, complement = _definite_control("A3")
    assert complement.module_rank() == 2
    assert int(complement.discriminant_quadratic_form().cardinality()) == 8

    fibre = tuple(lattice.vectors_of_square_and_divisibility(ZZ(2), root.div()))
    assert fibre
    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == _enumerated_orbit_count(lattice, fibre)
    delta, _isometry = found[0]
    assert delta.q() == ZZ(2)
    assert lattice.subobject_on([delta]).is_primitive() is True
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([delta]))
    ) is True


def test_a_definite_complement_of_rank_three_is_reached_through_its_own_image() -> None:
    r"""Item 2 at a complement of rank three: ``D4`` and the complement of a root.

    The complement is rank three with determinant eight and discriminant form of
    order eight with invariant factors ``(2, 2, 2)``: a definite complement whose
    glue is collapsed by the image of ``O(C)`` itself.
    """
    lattice, root, complement = _definite_control("D4")
    assert complement.module_rank() == 3
    assert int(complement.discriminant_quadratic_form().cardinality()) == 8

    fibre = tuple(lattice.vectors_of_square_and_divisibility(ZZ(2), root.div()))
    assert fibre
    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == _enumerated_orbit_count(lattice, fibre)
    delta, _isometry = found[0]
    assert delta.q() == ZZ(2)
    assert lattice.subobject_on([delta]).is_primitive() is True
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([delta]))
    ) is True


def test_two_glue_classes_of_a_definite_complement_collapse_to_one_orbit() -> None:
    r"""Item 2 where the glue has more than one class: ``A5`` and the complement of a root.

    The complement is rank four with determinant twelve, and its discriminant
    form carries two classes of the value and order the glue prescribes, so the
    collapse merges two classes where every other control here has one.
    """
    lattice, root, complement = _definite_control("A5")
    assert complement.module_rank() == 4
    assert int(complement.determinant()) == 12

    fibre = tuple(lattice.vectors_of_square_and_divisibility(ZZ(2), root.div()))
    assert fibre
    found = tuple(lattice.vectors_of_square_with_complement(ZZ(2), complement))
    assert sum(1 for _entry in found) == _enumerated_orbit_count(lattice, fibre)
    delta, _isometry = found[0]
    assert delta.q() == ZZ(2)
    assert lattice.subobject_on([delta]).is_primitive() is True
    assert complement.is_isometric_to(
        lattice.orthogonal_complement(lattice.subobject_on([delta]))
    ) is True


def test_the_enriques_gluing_gives_a_vector_of_square_minus_two_with_complement_t_co() -> None:
    r"""Items 3 and 4: the consumer specimen, its source's count, and its certificate.

    ``< -2 > perp T_Co`` sits in ``T_En`` with index two, so the gluing is one
    index-two overlattice.  The specimens are the papers' lattices, and the
    description that names each is checked here.  Alexeev--Engel--Garza--
    Schaffler (AEGS), *Compact moduli of Enriques surfaces of degree 2*, Nagoya
    Math. J. 259 (2025), 581--624, section 2 (arXiv:2312.03638v2), has
    ``T_En = U + U(2) + E8(2)``, rank 12 of signature ``(2, 10)``, even with
    ``|A| = 2^10`` -- their ``(12, 10, 0)_2``; Dolgachev--Kondo, Izv. Math.
    77:3 (2013), section 3 equation (3.6), printed p. 513, has
    ``T_Co = N = <2> + E(2)``, rank 11 of signature ``(2, 9)`` with
    ``|A| = 2^11``.  AEGS records that an indefinite even 2-elementary lattice
    is determined by its signature and its ``(r, a, d)``, so these invariants
    are the lattice and not a sample of it.

    The count is not this operation's own either: AEGS writes "By [Nam85, 2.13]
    there is a unique (-2)-vector in T_En modulo Gamma_En", and its Definition
    2.6 sets ``Gamma_En = O(T_En)``; [Nam85, 2.13] is Namikawa, *Periods of
    Enriques surfaces*, Math. Ann. 270 (1985), 201--222, Theorem 2.13.  So
    ``T_En`` carries one orbit of ``(-2)``-vectors, and exactly one of them has
    the complement of Dolgachev--Kondo, equation (3.6), printed p. 513, which is
    the vector that exists.
    """
    lattice = NamedLattices.TEn
    complement = NamedLattices.Tco

    assert lattice.module_rank() == 12
    assert tuple(lattice.signature()) == (2, 10)
    assert lattice.is_even() is True
    assert int(lattice.discriminant_group().cardinality()) == 2**10
    assert complement.module_rank() == 11
    assert tuple(complement.signature()) == (2, 9)
    assert complement.is_even() is True
    assert int(complement.discriminant_group().cardinality()) == 2**11

    pair_order = int((Lattices(ZZ)([[-2]]) + complement).discriminant_group().cardinality())
    lattice_order = int(lattice.discriminant_group().cardinality())
    assert pair_order % lattice_order == 0
    assert ZZ(pair_order // lattice_order).is_square() is True
    index = ZZ(pair_order // lattice_order).sqrt()

    found = tuple(lattice.vectors_of_square_with_complement(ZZ(-2), complement))
    assert sum(1 for _entry in found) == 1

    for delta, isometry in found:
        assert delta.q() == ZZ(-2)
        assert lattice.subobject_on([delta]).is_primitive() is True
        assert complement.is_isometric_to(
            lattice.orthogonal_complement(lattice.subobject_on([delta]))
        ) is True
        assert isometry.domain() is lattice
        overlattice = isometry.codomain()
        assert overlattice.signature() == lattice.signature()
        assert int(overlattice.discriminant_group().cardinality()) * index**2 == pair_order
        generator = isometry(delta)
        assert generator.q() == ZZ(-2)
        assert overlattice.subobject_on([generator]).is_primitive() is True
