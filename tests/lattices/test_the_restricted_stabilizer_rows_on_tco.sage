r"""The restricted stabilizers of the Coble divisor on ``T_Co``, computed (#359).

``delta`` is the ``(-2)``-vector of ``T_{\mathrm{En}}`` with
``delta^\perp`` isometric to ``T_Co`` (D. Dolgachev and S. Kond\=o, *Enriques
surfaces and Borel--Weil--Bott type duality*, Izv. Math. 77:3 (2013), the
sentence after Prop. 3.2, printed p. 513), and the restricted stabilizers of the
Coble divisor are the images in ``O(delta^\perp)`` of
``\operatorname{Stab}_\Gamma(delta)`` for ``\Gamma = O(T_{\mathrm{En}})`` and for
``\Gamma = \tilde O^+(T_{\mathrm{En}})``.  Each is built by that construction:
the stabilizer's own generators, restricted to the perpendicular.

This module asserts no statement of the research page.  ``prop:gamma-co-images``
states ``R_{\Gamma^K_{\mathrm{En}}} = O(T_{Co})`` and
``R_{\Gamma_{\mathrm{En}}} = \tilde O^+(T_{Co})``; what is asserted here is that
computed quantities agree with each other:

* the discriminant image of the constructed image, computed from the images of
  its generators under ``rho`` and the real spinor norm, against the
  discriminant image of the character subgroup those images describe;
* the construction inside the character subgroup it describes;
* the index of that subgroup in ``O(delta^\perp)``, computed from the images and
  the spinor norm, against the containment of every generator of
  ``O(delta^\perp)`` in the constructed image -- the same statement read on the
  integral side.  ``R_{\Gamma^K_{\mathrm{En}}}`` contains
  ``\tilde O(T_{Co}) = \ker\rho``, and ``R_{\Gamma_{\mathrm{En}}}`` contains
  ``\tilde O^+(T_{Co}) = \ker\rho \cap \ker sn``: an ``h`` there acts trivially
  on ``A_{T_Co}``, so ``h \oplus 1`` acts trivially on ``A_{T_{En}}``, which is a
  subquotient of ``A_{T_Co} \oplus A_{\langle\delta\rangle}``.  That containment
  is what makes the index over the finite classes the index in ``O(delta^\perp)``.

The measured values themselves, and the stop of the line row, are recorded in
``results/issue359-tco-restricted-stabilizers.md``.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _delta_and_perpendicular():
    r"""``delta = e - f`` of ``T_{\mathrm{En}}``'s hyperbolic plane, with ``q(delta) = -2``."""
    lattice = NamedLattices.TEn
    labels = tuple(lattice.module_generating_set())
    delta = lattice.module_generator(labels[0]) - lattice.module_generator(labels[1])
    perp = lattice.subobject_on((delta,)).inclusion().orthogonal_complement()
    return lattice, delta, perp


def _restricted(isometries, perp):
    r"""The restrictions of isometries of ``T_{\mathrm{En}}`` fixing ``delta`` to ``delta^\perp``."""
    inclusion = perp.inclusion()
    labels = tuple(perp.module_generating_set())
    return tuple(
        perp.O()(
            {
                label: inclusion.lift(
                    isometry(inclusion(perp.module_generator(label)))
                )
                for label in labels
            }
        )
        for isometry in isometries
    )


def _character_group(perp, family):
    r"""The character subgroup of ``O(delta^\perp)`` that the family's finite data describes.

    ``H`` is generated by the ``rho``-images of the family and ``sn`` is the real
    spinor norm; the returned group is ``rho^{-1}(H)``, met with ``ker sn`` when
    every element of the family already lies in it.  Both are computed, and the
    group carries complete character data, which is what the orbit rows require.
    """
    rho = perp.discriminant_representation()
    finite_image = perp.discriminant_group().orthogonal_group().subgroup(
        tuple(rho(element) for element in family)
    )
    plus = perp.O_plus()
    sign_morphism = plus.preimage_morphism()
    signs = tuple(sign_morphism(element).is_one() for element in family)
    character_group = perp.Aut().discriminant_preimage(finite_image)
    if all(signs):
        character_group = character_group.intersection(plus)
    return character_group, finite_image, signs


def test_the_restricted_stabilizer_agrees_with_the_character_group_it_describes() -> None:
    r"""The constructed image's finite data against the character group's own.

    The stabilizer of ``delta`` in ``O(T_{\mathrm{En}})`` generates the image
    ``R`` in ``O(delta^\perp)``; the images of its generators under ``rho`` and
    ``sn_{\mathbb R}`` generate the finite data of ``R``.  Every comparison below
    is between two quantities computed here.
    """
    lattice, delta, perp = _delta_and_perpendicular()
    assert perp.is_isometric(NamedLattices.Tco) is True

    stabilizer_family = tuple(lattice.Aut().stabilizer(delta).group_generators())
    restricted = _restricted(stabilizer_family, perp)
    image = perp.O().subgroup(restricted)
    character_group, finite_image, signs = _character_group(perp, restricted)

    image_order = finite_image.cardinality().finite_value()
    group_order = perp.discriminant_image().cardinality().finite_value()

    # (1) The character description reproduces the computed image, not a bigger one.
    assert character_group.discriminant_image().cardinality().finite_value() == image_order

    # (2) The construction lies in the group its finite data describes.
    assert all(element in character_group for element in restricted)

    # (3) The index over the finite classes, and the same statement on the
    # integral side: index one exactly when the ambient group is the image.
    sign_label_count = 2 if False in set(signs) else 1
    index_from_images = 2 * group_order // (image_order * sign_label_count)
    contained = all(element in image for element in perp.O().group_generators())
    assert (index_from_images == 1) == contained
