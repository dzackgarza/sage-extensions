r"""``G_L = {g in G : g(L) = L}`` for a lattice inside a rational space.

A lattice in a ``QQ``-space ``V`` is a ``ZZ``-submodule of the restriction of
scalars of ``V``, and the integral stabilizer of a rational group ``G`` is cut
out of ``G`` by ``g(L) = L``.  The specimens live in the hyperbolic plane over
``QQ``, where ``diag(t, 1/t)`` is an isometry for every nonzero ``t``: on the
isotropic line ``ZZ e_0`` that isometry gives ``g(L) < L``, which separates the
equality from the containment.

The groups are supplied subgroups of ``O``, generated by isometries the caller
states.  That is the datum ``stabilizer()`` reads: it needs a selected finite
generating set of the group, which the whole rational ``O`` does not supply by
itself (its generator algorithm is the integral lattice's,
``_computed_group_generators``, and it refuses a rational lattice).  An owned
isometry is written as a function on the lattice's module generators; its
elements are not hashable, so a dictionary of generator images is not a datum
here.
"""

from sage_extensions.all import *


def _rational_hyperbolic_plane():
    r"""``U`` over ``QQ``, the ``ZZ``-space ``Res(U)`` it is read in, and ``O(U)``."""
    plane = Lattices(QQ)("U")
    restriction = Modules(QQ).restriction_of_scalars(ZZ.Mor(QQ)(lambda n: QQ(n)))
    space = restriction(plane)
    labels = plane.module_generating_set()
    basis = [plane.module_generator(label) for label in labels]
    return plane, space, basis, plane.Aut()


def test_diag_two_half_maps_an_isotropic_line_properly_into_itself_and_leaves_its_stabilizer() -> None:
    r"""``diag(2, 1/2)`` carries ``ZZ e_0`` onto ``2 ZZ e_0 < ZZ e_0``; ``-1`` carries it onto itself."""
    plane, space, basis, orthogonal_group = _rational_hyperbolic_plane()
    e0 = basis[0]
    half = QQ(1) / QQ(2)
    line = space.subobject_on([space(e0)])
    scaling = orthogonal_group(
        lambda label: 2 * basis[int(label)] if int(label) == 0 else half * basis[int(label)]
    )
    negation = orthogonal_group(lambda label: -basis[int(label)])

    group = orthogonal_group.subgroup((scaling, negation))
    stabilizer = IntegralStructureAction(group, line.inclusion()).stabilizer()

    assert space(scaling(e0)) in line
    assert scaling not in stabilizer
    assert negation in stabilizer


def test_the_swap_stabilizes_the_standard_lattice_but_not_a_commensurable_one() -> None:
    r"""The swap ``e_0 <-> e_1`` preserves ``ZZ e_0 + ZZ e_1`` but sends ``e_1/2`` out of ``ZZ e_0 + ZZ e_1/2``."""
    plane, space, basis, orthogonal_group = _rational_hyperbolic_plane()
    e0, e1 = basis
    half = QQ(1) / QQ(2)
    standard = space.subobject_on([space(e0), space(e1)])
    finer = space.subobject_on([space(e0), space(half * e1)])
    swap = orthogonal_group(lambda label: basis[1 - int(label)])
    group = orthogonal_group.subgroup((swap,))

    assert swap in IntegralStructureAction(group, standard.inclusion()).stabilizer()
    assert swap not in IntegralStructureAction(group, finer.inclusion()).stabilizer()
