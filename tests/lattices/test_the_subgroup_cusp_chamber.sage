r"""The chamber at a 0-cusp, for a reflection subgroup of ``O(K)`` given by its reflections.

Vinberg's algorithm (E. B. Vinberg, *Some arithmetical discrete groups in
Lobacevskii spaces*, 1975; Conway--Sloane, *SPLAG*, 3rd ed., Ch. 27, §2) builds
the fundamental polyhedron of the group generated by the reflections in the roots
it accepts.  A *subgroup* of finite index generated by reflections has a different
polyhedron -- the intersection of the half-spaces of its own root system -- so the
restriction has to sit inside the algorithm: a candidate root is a wall only when
its reflection lies in the subgroup.  ``fundamental_chamber(admits_root=...)`` is
that filter, and ``subgroup_fundamental_chamber(generators=...)`` builds it from a
subgroup given by generators; the tests below take the filter directly, because
the criterion they pass is decidable, while membership in a subgroup given by
generators of an indefinite lattice is not.  That is the path #285 takes: the
image of the stabilizer supplies the decidable criterion, and the group does not
have to be searched.

The specimen is Sterk's cusp lattice ``U + E8(-2)`` (H. Sterk,
*Compactifications of the period space of Enriques surfaces, Part I*,
Math. Z. 207 (1991), 1--36, §4.3.1, p. 17, where the cusp chamber is that of the
image of the integral stabilizer in ``O(v^perp/Zv)``).  The full group's chamber
of this lattice has ten walls; four of Sterk's five cusp diagrams (§4.3.5--4.3.9)
have 12, 12, 11 and 14, so their chambers are those of proper reflection
subgroups and only the restricted algorithm produces them.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _cusp_lattice():
    r"""``U + E8(-2)`` as a hyperbolic lattice: rank 10, signature ``(1, 9)``."""
    return HyperbolicLattices(ZZ)(NamedLattices.U_E8_2)


def test_the_full_chamber_of_the_cusp_lattice_completes() -> None:
    r"""Every wall a root of square ``-2`` or ``-4``, and the search completes.

    This is the fixed point of the restricted operation: with no filter it must
    return the full group's chamber, which is what ``fundamental_chamber`` did
    before the filter existed.
    """
    lattice = _cusp_lattice()
    chamber = lattice.fundamental_chamber()
    roots = tuple(chamber.wall_roots())

    assert chamber.is_complete_wall_set() is True
    assert all(lattice.b(root, root) in (ZZ(-2), ZZ(-4)) for root in roots)


def test_the_subgroup_cusp_chamber_at_the_first_cusp_has_the_card_wall_count() -> None:
    r"""Twelve walls on ``U(2) + E8(-2)`` with Sterk's twelve reflections, against card ``029J``.

    The Enriques cusp lattice at Sterk's first cusp is ``U(2) + E8(-2)``: the
    reduction ``v^perp/Zv`` of ``T_En = U + U(2) + E8(-2)`` at ``v = e``, the
    generator of the unimodular plane, is the ``U(2) + E8(-2)`` part orthogonal
    to ``e``, and the twelve roots Sterk prints for diagram 4.3.5 are vectors of
    ``T_En`` lying in ``e^perp``, so their classes in the reduction are read here
    by dropping the ``e``-coordinate.

    The subgroup is the one Sterk names for that cusp: the reflections in the
    twelve printed roots, which generate the reflection part of the image of the
    stabilizer, since the reflections in the walls of a fundamental chamber
    generate the reflection group.  The chamber of that subgroup anchored at the
    cusp is what ``subgroup_cusp_chamber`` returns, and its wall count is the
    number Sterk publishes for the diagram: the ``gamma-en-2`` row 4.3.5 of card
    ``029J`` (H. Sterk, *Compactifications of the period space of Enriques
    surfaces, Part I*, Math. Z. 207 (1991), §4.3.5, p. 19), read here by tag.

    The membership is decided where it is decidable: the discriminant images of
    the twelve reflections generate a subgroup of the finite orthogonal group of
    the discriminant quotient, and one sifting test of a Schreier--Sims
    stabilizer chain (A. Seress, *Permutation Group Algorithms*, Cambridge
    University Press 2003, chapter 4) answers each root's question.  The walk
    itself is Vinberg's (E. B. Vinberg, *On the groups of unit elements of
    certain quadratic forms*, Math. USSR Sb. 16 (1972), §3.2, Proposition 4
    (p. 28) and Proposition 5 (p. 29)), and it stops on the finite-volume
    criterion, so ``is_complete_wall_set()`` is the algorithm's own termination
    and not an extra certificate.
    """
    lattice = NamedLattices.SEn
    roots = tuple(Sterk.sterks_in_TEn()["Sterk_1"])
    labels = ("ep", "fp") + tuple(f"a{index}" for index in range(1, 9))
    transported = tuple(
        lattice([int(root.to_vector()(label)) for label in labels]) for root in roots
    )
    K = HyperbolicLattices(ZZ)(lattice)
    group_generators = tuple(K.reflection(cls) for cls in transported)
    cusp = next(
        generator
        for generator in lattice.module_generators()
        if lattice.q(generator) == ZZ.zero()
    )
    chamber = K.subgroup_cusp_chamber(cusp, group_generators=group_generators)
    walls = tuple(chamber.wall_roots())
    row = card("cusp_chambers", "029J")["rows"]["gamma-en-2"][0]

    assert cardinal(sum(1 for _ in roots)) == cardinal(12)
    assert all(lattice.q(cls) == ZZ(-4) for cls in transported)
    assert chamber.is_complete_wall_set() is True
    assert cardinal(sum(1 for _ in walls)) == cardinal(row["walls"])
    assert all(lattice.b(root, root) in (ZZ(-2), ZZ(-4)) for root in walls)


def test_the_root_filter_removes_a_wall_whose_reflection_it_refuses() -> None:
    r"""A refused root is not a wall, and every returned wall passes the filter.

    The predicate here refuses exactly one root of the full chamber, by
    coordinates, which is the root filter of #297 with a decidable criterion --
    the same shape as the discriminant criterion #285 passes.
    """
    lattice = _cusp_lattice()
    roots = tuple(lattice.fundamental_chamber().wall_roots())
    refused = tuple(int(entry) for entry in roots[-1].to_vector())

    def admits_root(root):
        return tuple(int(entry) for entry in root.to_vector()) != refused

    chamber = lattice.fundamental_chamber(
        admits_root=admits_root,
        max_roots=40,
        max_decompositions=400,
    )
    restricted = tuple(chamber.wall_roots())

    assert all(tuple(int(entry) for entry in root.to_vector()) != refused for root in restricted)
    assert all(admits_root(root) for root in restricted)
    assert all(lattice.b(root, root) in (ZZ(-2), ZZ(-4)) for root in restricted)
