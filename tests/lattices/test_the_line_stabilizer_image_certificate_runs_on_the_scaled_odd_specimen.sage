r"""The certificate runs on the library's own scaled odd specimen, and on the glued one.

The arithmetic file `test_the_line_stabilizer_image_certificate_is_divisor_independent.sage`
exhibits the two obligations on Gram matrices alone.  This file runs the *production*
calls on the lattices those matrices present, constructed through ``Lattices(ZZ)``:

* the positive case: ``B = U + <-1> + <-1>``, ``T = B(2)``, ``v = e``.  The
  primitive isotropic line ``<e>`` has divisor two.  ``general_image_certificate``
  is asked on the stable orthogonal group's quotient and on the joint
  stable-times-``O^+`` quotient, and both answer ``1``; the line's own finite
  image is the group generated by the two exhibited integral stabilizer
  elements -- the swap ``d_1 <-> d_2`` and the transvection ``E_B(e, d_1 + d_2)``
  -- and has order four, which is the four matrices the arithmetic file
  enumerates independently of the implementation.

* the invalid gluing hypothesis: ``L = M + Z w`` with ``M = U(2) + <2>^5`` and
  ``w = (e + k_1 + k_2 + k_3 + k_4)/2``.  The swap ``k_4 <-> k_5`` extended by
  the identity on ``<e, f>`` is an isometry of the quadratic space fixing the
  plane and acting surjectively on the complement ``K = <2>^5``'s discriminant
  group, and it is *not* integral: it sends ``w`` to ``w + (k_5 - k_4)/2``.  The
  lattice certifies the non-integrality itself -- ``2w + k_5 - k_4`` is in ``L``
  and pairs to ``3`` with ``w``, so it is not twice anything in ``L`` -- which is
  what makes complement surjectivity the wrong hypothesis for the certificate.
"""

from sage_extensions.all import *  # noqa: F401,F403


def _scaled_odd_specimen():
    r"""``T = (U + <-1> + <-1>)(2)``, with the line spanned by its first ``U`` vector."""

    base = Lattices(ZZ)("U") + Lattices(ZZ)([[-1]]) + Lattices(ZZ)([[-1]])
    lattice = base.twist(2)
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[0])
    return lattice, labels, vector, lattice.primitive_isotropic_subobject(vector)


def _swap_the_negative_plane(lattice, labels):
    r"""``e, f`` fixed and ``d_1 <-> d_2``: an integral isometry of ``T``."""

    e, f, d1, d2 = labels
    return lattice.Aut()({e: lattice.module_generator(e), f: lattice.module_generator(f),
                          d1: lattice.module_generator(d2), d2: lattice.module_generator(d1)})


def _transvection_along_the_sum(lattice, labels):
    r"""``E_B(e, d_1 + d_2)``: ``f |-> e + f + d_1 + d_2``, ``d_i |-> d_i + e``.

    Its parameter ``a = d_1 + d_2`` has ``b_B(a, a) = -2``, and ``E_B`` preserves
    ``b_B``, hence preserves ``b_T = 2 b_B``: it is an integral isometry of ``T``
    fixing ``e``, and its reduction is one of the four enumerated matrices.
    """

    e, f, d1, d2 = labels
    ring = lattice.base_ring()
    one = ring.one()
    return lattice.Aut()(
        {
            e: lattice.module_generator(e),
            f: lattice.linear_combination(
                {e: one, f: one, d1: one, d2: one}
            ),
            d1: lattice.linear_combination({e: one, d1: one}),
            d2: lattice.linear_combination({e: one, d2: one}),
        }
    )


def test_the_scaled_odd_specimen_certificate_answers_one() -> None:
    r"""The line's datum fibre has one ``ker rho``-orbit, on both quotients."""

    lattice, labels, vector, line = _scaled_odd_specimen()
    assert lattice.div(vector) == 2, "the specimen's line must have divisor two"
    stable = lattice.stable_orthogonal_group()
    assert general_image_certificate(stable.finite_character_quotient(), line) == 1
    joint = stable.intersection(lattice.O_plus())
    assert general_image_certificate(joint.finite_character_quotient(), line) == 1


def test_the_scaled_odd_specimens_image_is_the_four_enumerated_matrices() -> None:
    r"""The stabilizer's finite image is generated by the swap and the transvection."""

    lattice, labels, vector, line = _scaled_odd_specimen()
    image = line.stabilizer_discriminant_image()
    rho = lattice.discriminant_representation()
    orthogonal = lattice.discriminant_group().orthogonal_group()
    swap = rho(_swap_the_negative_plane(lattice, labels))
    transvection = rho(_transvection_along_the_sum(lattice, labels))
    generated = orthogonal.subgroup((swap, transvection))
    assert generated.cardinality() == cardinal(4), (
        "the two exhibited integral stabilizer elements must generate four classes"
    )
    assert image.cardinality() == cardinal(4), (
        "the line stabilizer's finite image has the four enumerated elements"
    )
    assert all(generator in image for generator in generated.group_generators())
    assert all(generator in generated for generator in image.group_generators())


def test_the_glued_swap_is_not_integral_and_the_lattice_says_so() -> None:
    r"""``L = M + Z w``: the plane-fixing complement swap moves ``w`` out of ``L``.

    With ``L``'s basis ``(w, k_1, ..., k_5, f)`` the form is
    ``q(w) = q(k_i) = 2``, ``b(w, k_i) = 1`` for ``i <= 4``, ``b(k_i, k_j) = 2 delta_ij``
    and ``b(w, f) = 1``, so ``det L = -32`` and ``e = 2w - k_1 - k_2 - k_3 - k_4`` is
    primitive of divisor two.  The swap ``k_4 <-> k_5`` fixes ``e`` and ``f`` and is an
    isometry of ``L (x) QQ``; it sends ``w`` to ``w + (k_5 - k_4)/2``.  Write
    ``x = w + (k_5 - k_4)/2``: then ``2x = 2w + k_5 - k_4`` lies in ``L``, and
    ``b(2x, w) = 3`` is odd, so ``2x`` is not twice an element of ``L`` and
    ``x`` is not in ``L``.  The swap therefore does not preserve ``L``, although
    its restriction to the complement ``K`` is an isometry of ``K`` and ``K``'s
    signed permutations realize the whole ``O(q_K)``.
    """

    gram = (
        (2, 1, 1, 1, 1, 0, 1),
        (1, 2, 0, 0, 0, 0, 0),
        (1, 0, 2, 0, 0, 0, 0),
        (1, 0, 0, 2, 0, 0, 0),
        (1, 0, 0, 0, 2, 0, 0),
        (0, 0, 0, 0, 0, 2, 0),
        (1, 0, 0, 0, 0, 0, 0),
    )
    lattice = Lattices(ZZ)(gram)
    assert lattice.determinant() == -32
    labels = tuple(lattice.module_generating_set())
    w, k1, k2, k3, k4, k5, f = (lattice.module_generator(label) for label in labels)
    ring = lattice.base_ring()
    one, two = ring.one(), ring(2)
    e = lattice.linear_combination({labels[0]: two, labels[1]: -one, labels[2]: -one,
                                    labels[3]: -one, labels[4]: -one})
    assert lattice.b(e, e) == ring.zero()
    assert lattice.b(e, f) == two
    assert lattice.div(e) == 2, "e is primitive of divisor two in L"
    for k in (k1, k2, k3, k4, k5):
        assert lattice.b(e, k) == ring.zero() and lattice.b(f, k) == ring.zero(), (
            "K lies in the plane's orthogonal complement"
        )
    # The swap's obstruction, certified by the lattice: 2x = 2w + k_5 - k_4 is in L,
    # and it is not twice an element of L because its pairing with w is odd.
    two_x = lattice.linear_combination({labels[0]: two, labels[5]: one, labels[4]: -one})
    assert lattice.b(two_x, w) == ring(3)
    assert lattice.div(two_x) == 1, (
        "an element of 2L has all pairings even; this one's pairing with w is three"
    )


def test_the_stable_line_walk_returns_the_three_exact_unoriented_classes() -> None:
    r"""For B=U+<-1>^2, the three nonzero singular classes of B/2B occur.

    The norm modulo four is 2ef-d1^2-d2^2. Enumerating binary entries
    gives exactly e, f and e+f+d1+d2. Swapping e and f and the integral
    Eichler transvection with parameter d1+d2 transport e to all three.
    Every primitive isotropic vector of the odd unimodular B has
    divisor one. Its square-zero hyperbolic partner can be chosen
    since its reduction is not the characteristic class d1+d2
    (that class has norm two modulo four). The orthogonal complement
    is a negative definite unimodular binary lattice, necessarily
    <-1>^2: Gauss reduction gives a shortest norm a with
    1=ac-b^2 >= 3a^2/4, hence a=1. Splitting off that vector proves
    the assertion. Thus the ambient line orbit is single.
    The four-element stabilizer image is independently enumerated in
    the companion arithmetic test, and equals the finite class stabilizer.
    The normal-kernel double-coset bijection then gives these three
    actual kernel orbits, not just a count.
    """
    lattice, labels, vector, line = _scaled_odd_specimen()
    e, f, d1, d2 = tuple(lattice.module_generator(label) for label in labels)
    stable = lattice.stable_orthogonal_group()
    # Both collections are Python sets. A brace literal in a .sage file is
    # lowered to an owned finite set, not the type constructed by set().
    expected = set((
        lattice.divided_discriminant_class(e),
        lattice.divided_discriminant_class(f),
        lattice.divided_discriminant_class(e + f + d1 + d2),
    ))
    representatives = stable.isotropic_orbit_representatives(1)
    assert representatives.cardinality() == cardinal(3)
    actual = set()
    for representative in representatives:
        label = tuple(representative.module_generating_set())[0]
        moved = representative.inclusion()(representative.module_generator(label))
        assert moved.is_primitive()
        assert moved.q() == lattice.base_ring().zero()
        assert lattice.div(moved) == 2
        actual.add(lattice.divided_discriminant_class(moved))
    assert actual == expected
