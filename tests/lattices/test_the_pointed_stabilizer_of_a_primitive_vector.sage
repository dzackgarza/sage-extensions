r"""``Stab_{O(L)}(v)``'s generators: the rank-one parabolic, and complement and glue.

A pointed marking ``<q(v)> -> L`` asks for the stabilizer of the *vector* `v`.
Two constructions answer it, and neither is the indefinite port's:

* an **isotropic** `v` has `I = Zv` inside its own perpendicular, so the pointed
  stabilizer is `P_I^1 = ker(P_I -> O(I))`, the kernel of the sign of the action
  on `v` inside the parabolic `P_I` whose generators ``sage-extensions#459``
  builds.  A subgroup of index two is generated by the Schreier family of its two
  cosets: with `S` the parabolic's family made symmetric and the transversal
  `{1, a}` for one reversing `a`, the words `w_{tP}^{-1} t w_P` fix the coset they
  are applied to and generate the kernel.  Pairing `a t` alone does not: it drops
  the conjugates `a^{-1} t a` of the members that already fix `v`, and for
  `f = (12)(34)` even and `r = (02)` odd in `S_4` the kernel of the sign in
  `\langle f, r\rangle` has order six while `f` and `r^2 = 1` generate two.
* a **non-isotropic** `v` has `K = v^\perp \cap L` of rank `n - 1` and
  `L_0 = Zv \perp K` of finite index in `L`; an isometry of `K` extends to `L`
  fixing `v` exactly when it preserves the gluing subgroup `H = L/L_0` of
  `A_{L_0}` (Nikulin, *Integral symmetric bilinear forms and some of their
  applications*, Math. USSR Izv. 14 (1980), Proposition 1.4.1: overlattices of
  `L_0` correspond to the isotropic subgroups of `A_{L_0}`).  The stabilizer is
  then the stabilizer of a point under the action of `O(K)` on the finite set of
  subgroups of `A_{L_0}`, and the same Schreier family over that orbit generates
  it.

The specimens are read from ``dzackgarza/lattice-database`` by tag, never typed:

* card ``0016`` is the hyperbolic plane `U`, rank 2 -- the smallest indefinite
  lattice.  `e + f` is primitive of square `2`, and `U` has exactly two vectors
  of that square, `+- (e + f)`, so the `O(U)`-orbit of `e + f` is `{+- (e+f)}`
  and the stabilizer of the line has index two in `O(U)`.  `g(e+f) = e+f` forces
  `g(e-f) = +- (e-f)`, and the two choices are the identity and the exchange
  `e <-> f`: the pointed stabilizer is `{1, e<->f}` and the setwise one is
  `{1, e<->f, -e<->-f, e<->f · -e<->-f}` of order four.  This is the example of
  `tests/lattices/test_nondegenerate_marking_stabilizers.sage`, whose own file
  does not collect (its test-lint findings), so the orders are derived in the
  paragraphs above rather than read there.
* card ``026E`` is `U + D4(-1) + A1(-1)`, rank seven and signature `(1, 6)`, and
  its certified row ``integral.primitive_orbits`` is the card's own count of the
  orbits of its primitive vectors: one `O`-orbit of primitive isotropic vectors
  and one `SO`-orbit.  Its `K_I` at the hyperbolic summand's generator is the
  negative definite `D4(-1) + A1(-1)`, so `O(K_I)` is finite and the isotropic
  family's image in it is a computation.
"""

from sage_extensions.all import *  # noqa: F401,F403

# The rank-seven catalogued specimen, and the hyperbolic plane.
RANK_SEVEN = "026E"
HYPERBOLIC_PLANE = "0016"


def _lattice(tag):
    r"""The lattice that card ``tag``'s own Gram matrix describes, in ``Lattices(ZZ)``."""
    return Lattices(ZZ)(card("primitive_orbit_series", tag)["gram"])


def _pointed_generators(lattice, vector):
    r"""The library's generators of the stabilizer of ``vector`` in ``O(L)``."""
    return tuple(lattice.Aut().stabilizer(vector).group_generators())


def test_the_setwise_stabilizer_of_a_nonsingular_line_returns() -> None:
    r"""`U` at `e + f`: four isometries, one of them negating `e + f`.

    The port refuses this marking outright at the parent ("does not mark a
    totally isotropic sublattice"), and `U` is the smallest indefinite lattice.
    The order is the one derived in the module docstring: `P = {1, e<->f}` and
    its reversing coset `{-e<->-f, e<->f . -e<->-f}`.
    """
    lattice = _lattice(HYPERBOLIC_PLANE)
    first, second = tuple(lattice.module_generators())
    vector = first + second
    assert lattice.b(vector, vector) == ZZ(2)
    assert vector.is_primitive() is True
    assert lattice.vectors_of_square(lattice.b(vector, vector)).cardinality() == cardinal(2)

    family = tuple(
        lattice.Aut().setwise_stabilizer(vector.sublattice().inclusion()).group_generators()
    )
    assert family
    assert all(generator(vector) in (vector, -vector) for generator in family)
    assert any(generator(vector) == -vector for generator in family)
    assert lattice.Aut().subgroup(family).cardinality() == cardinal(4)


def test_the_pointed_stabilizer_of_a_nonsingular_line_is_the_complement() -> None:
    r"""`U` at `e + f`: two isometries, both fixing `e + f`, the exchange and the identity.

    `K = (e+f)^\perp \cap U = Z(e-f)` is definite, so `O(K)` is finite and both of
    its members preserve the gluing subgroup of order two: the complement
    contributes the exchange, and the reversing isometry the setwise family adds
    is `-1` on the line.
    """
    lattice = _lattice(HYPERBOLIC_PLANE)
    first, second = tuple(lattice.module_generators())
    vector = first + second

    family = _pointed_generators(lattice, vector)
    assert family
    assert all(generator(vector) == vector for generator in family)
    assert any(generator(first) != first for generator in family)
    assert lattice.Aut().subgroup(family).cardinality() == cardinal(2)


def test_a_summands_generator_keeps_its_complements_isometries() -> None:
    r"""`U + A1` at the `A1` generator: the complement is `U`, and its isometries fix the vector.

    `b(v,v) = -2` and `Zv` splits off, so every isometry of `K = U` extends by the
    identity on the line: the family is `O(U)`'s, and it acts nontrivially on `U`.
    """
    lattice = Lattices(ZZ)("U") + Lattices(ZZ)("A1")
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[-1])
    hyperbola = lattice.module_generator(labels[0])
    assert lattice.b(vector, vector) == ZZ(-2)
    assert vector.is_primitive() is True

    family = _pointed_generators(lattice, vector)
    assert family
    assert all(generator(vector) == vector for generator in family)
    assert any(generator(hyperbola) != hyperbola for generator in family)


def test_the_pointed_family_fixes_its_vector_and_the_setwise_one_does_not() -> None:
    r"""Every member of the isotropic pointed family fixes `v`; the setwise family has one that negates it.

    The second half keeps the first from holding of a vacuous family: the two
    markings `v` and `Zv` are different questions, and a coslice at `v` answered
    with the line's family would contain the element that sends `v` to `-v`.
    """
    lattice = _lattice(RANK_SEVEN)
    labels = tuple(lattice.module_generating_set())
    isotropic = lattice.module_generator(labels[0])
    hyperbolic = lattice.module_generator(labels[-1])

    for vector in (isotropic, hyperbolic):
        family = _pointed_generators(lattice, vector)
        assert family
        assert all(generator(vector) == vector for generator in family)

    line = isotropic.sublattice()
    setwise = tuple(lattice.Aut().setwise_stabilizer(line.inclusion()).group_generators())
    assert any(generator(isotropic) == -isotropic for generator in setwise)


def test_the_pointed_family_fills_the_levi_factor_of_its_parabolic() -> None:
    r"""The isotropic family's image in `O(K_I)` is the whole of it.

    `P_I^1 -> O(K_I)` is injective on the kernel's complement, so a family whose
    image is all of `O(K_I)` misses nothing of the action on `K_I`.  `O(K_I)` is
    finite here, and its order is the computation the image is compared against.
    """
    lattice = _lattice(RANK_SEVEN)
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[0])
    reduction = lattice.primitive_isotropic_subobject(vector).isotropic_reduction()
    quotient = reduction.quotient_lattice()
    action = reduction.levi_action()

    family = _pointed_generators(lattice, vector)
    images = tuple(action(generator) for generator in family)

    assert quotient.O().subgroup(images).cardinality() == quotient.O().cardinality()


def test_the_primitive_isotropic_orbit_counts_are_the_card_rows() -> None:
    r"""The card's certified count of those orbits, through the public orbit call.

    Card ``026E`` states one `O`-orbit and one `SO`-orbit of its primitive
    isotropic vectors.  The count is the orbit-stabilizer index of the pointed
    family's image, so the row is read on the group whose stabilizer family the
    pointed call answers.
    """
    lattice = _lattice(RANK_SEVEN)
    rows = card("primitive_orbit_series", RANK_SEVEN)["rows"]

    assert lattice.Aut().isotropic_orbit_representatives(1).cardinality() == rows["O"]["constant"]
    assert lattice.special_orthogonal_group().isotropic_orbit_representatives(1).cardinality() == rows["SO"]["constant"]


def test_the_hyperbolic_planes_pointed_stabilizer_is_trivial() -> None:
    r"""`K_I = 0`: the family is empty, and the card's one `O`-orbit of isotropic lines stands.

    `g(e) = e` forces `g` to be the identity on `U`, so the stabilizer is trivial
    and its generating family is empty; card ``0016`` states one `O`-orbit of
    primitive isotropic vectors.
    """
    lattice = _lattice(HYPERBOLIC_PLANE)
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[0])
    rows = card("primitive_orbit_series", HYPERBOLIC_PLANE)["rows"]

    assert lattice.q(vector) == ZZ(0)
    assert vector.is_primitive() is True
    assert _pointed_generators(lattice, vector) == ()
    assert lattice.Aut().isotropic_orbit_representatives(1).cardinality() == rows["O"]["constant"]
