r"""The public pointed family of an odd isotropic vector: both factors of the extension.

For a primitive isotropic `v`, the stabilizer of the vector sits in

    1 -> U_I -> P_I^1 -> M_I -> 1,

with `U_I` the kernel of the action on `K_I = v^perp/Zv`.  The public pointed
call answers two questions at once: which isometries of `K_I` lift integrally,
and which Eichler transvections the radical has.  On a lattice that splits
along the chosen lifts of `K_I`, every isometry of `K_I` lifts as
`id_M + sigma`, and the radical is generated by the transvections at the
even-square parameters -- so the family is one lift of each generator of
`O(K_I)` together with the radical's own generators.

What is asserted of the returned family is what follows from generation rather
than from the choice of family: that it is non-empty, that every member fixes
`v`, and that its image in the finite orthogonal group is the image of
`O(K_I)` itself.  Which *particular* member is a radical element is a property
of the chosen family and not of the group it generates, so it is not asserted
here; the radical's own generation is asserted in
``test_the_pointwise_radical_of_a_primitive_isotropic_line.sage``.

The specimens are Gram matrices or the catalogued nonreflective lattice, and
each asserts the property that makes it the specimen it is:

* `U + <3>` is odd, its `K_I` is `<3>`, and its marked vector has divisibility
  one; its radical is generated by the transvection at `2 g`, of square twelve.
* `U + K` for the Bogachev--Kolpakov nonreflective `K` is odd, of signature
  `(2, 3)` and discriminant `2401`, and splits along the lifts of `K_I`.  It
  is the specimen whose public pointed call the indefinite port did not answer
  at 520 s, the residue action did not answer at 520 s, and whose two factors
  are each computed in seconds.

No count is typed: the assertion about the finite image is that it is the
image of `O(K_I)` itself, which is a subgroup identity and not an order read
from a table.
"""

from sage_extensions.all import *  # noqa: F401,F403

ODD = [[0, 1, 0], [1, 0, 0], [0, 0, 3]]


def _marked(lattice=None):
    r"""A lattice (the nonreflective specimen when none is given), its marked vector, and that line's subobject."""
    if lattice is None:
        lattice = Lattices(ZZ)("U") + NamedLattices.BogachevKolpakovNonReflective
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[0])
    return lattice, vector, lattice.primitive_isotropic_subobject(vector)


def _finite_image(reduction, family):
    r"""The subgroup of the finite orthogonal group that ``family`` generates."""
    quotient = reduction.quotient_lattice()
    rho = quotient.discriminant_representation()
    action = reduction.pointwise_levi_action()
    return rho.codomain().subgroup(
        tuple(rho(action(isometry)) for isometry in family)
    )


def _image_of_the_quotient_group(reduction):
    r"""The subgroup of the finite orthogonal group that `O(K_I)` generates."""
    quotient = reduction.quotient_lattice()
    rho = quotient.discriminant_representation()
    return rho.codomain().subgroup(
        tuple(rho(generator) for generator in quotient.O().group_generators())
    )


def _assert_the_family_answers(lattice, vector, subobject) -> None:
    r"""The public family fixes the vector and its finite image is the image of `O(K_I)`.

    Both are consequences of generation and not of the chosen family: every
    member of `P_I^1` fixes `v`, and the image of a generating family under
    `P_I^1 -> O(K_I)` generates the image of the group.  Equality with the
    image of `O(K_I)` -- rather than containment in it -- says the Levi factor
    is complete, which is the half of the extension that the lifts supply.
    """
    reduction = subobject.isotropic_reduction()
    family = tuple(lattice.Aut().stabilizer(vector).group_generators())

    assert family
    assert all(isometry(vector) == vector for isometry in family)
    assert _finite_image(reduction, family).cardinality() == _image_of_the_quotient_group(reduction).cardinality()


def test_the_public_pointed_family_of_an_odd_line_carries_both_factors() -> None:
    r"""`U + <3>`: an odd line whose `K_I` is `<3>`, with the transvection at `2 g` in the family.

    The parameter `2 g` has square twelve, so its transvection is integral and
    it lies in the radical; `id_M + sigma` supplies the other factor, so the
    finite image is the whole of the image of `O(K_I) = {+-1}`.
    """
    lattice, vector, subobject = _marked(Lattices(ZZ)(ODD))
    reduction = subobject.isotropic_reduction()

    assert lattice.is_even() is False
    assert vector.q() == ZZ(0)
    assert vector.is_primitive() is True
    assert vector.div() == ZZ(1)
    assert reduction.quotient_lattice().module_rank() == NN(1)

    _assert_the_family_answers(lattice, vector, subobject)


def test_the_public_pointed_family_of_the_odd_nonreflective_lattice_returns() -> None:
    r"""`U + K` at the nonreflective odd `K`: the public call answers instead of falling through.

    The lattice is odd, so the residue action's coset logic does not apply to
    it, and it does not need to: the lifts of `K_I` split the lattice, so
    `id_M + sigma` is an integral lift at every `sigma in O(K_I)` and the
    radical is the even-square transvections.  Both factors are asserted, at
    the marked vector of divisibility one.
    """
    lattice, vector, subobject = _marked()
    reduction = subobject.isotropic_reduction()
    quotient = reduction.quotient_lattice()

    assert lattice.is_even() is False
    assert lattice.signature_pair().first() == NN(2)
    assert lattice.signature_pair().second() == NN(3)
    assert vector.q() == ZZ(0)
    assert vector.is_primitive() is True
    assert vector.div() == ZZ(1)
    assert quotient.module_rank() == NN(3)

    _assert_the_family_answers(lattice, vector, subobject)
