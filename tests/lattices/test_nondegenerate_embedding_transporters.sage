r"""Exact primitive-glue transport between distinct integral lattice presentations.

The basis change from U with e.f=1 to the Gram [[2,1],[1,0]]
with basis a,b is e -> a-b, f -> b. It sends the primitive square-two
line generated by e+f to the line generated by a. This must construct
an arrow between the two different ambient parents, not a member of O(U).
"""

from sage_extensions.all import *


def test_public_moving_embedding_transporter_has_distinct_source_and_target():
    source = Lattices(ZZ)([[2]])
    first_lattice = Lattices(ZZ)("U")
    second_lattice = Lattices(ZZ)([[2, 1], [1, 0]])
    e, f = tuple(first_lattice.module_generators())
    a, b = tuple(second_lattice.module_generators())
    (root,) = tuple(source.module_generators())
    arrows = Cat().Mor(FiniteOrdinalCategory(2), Lattices(ZZ))
    first = arrows.object(source.Emb(first_lattice)({root: e + f}))
    second = arrows.object(source.Emb(second_lattice)({root: a}))
    homset = arrows.Core().Mor(first, second)
    assert homset.is_empty() is False
    witness = homset.an_element()
    apex = witness.forward().right()
    assert apex.domain() is first_lattice and apex.codomain() is second_lattice
    assert apex(e + f) in (a, -a)
    assert all((~apex)(apex(x)) == x for x in (e, f))
    assert all(first_lattice.b(x, y) == second_lattice.b(apex(x), apex(y)) for x in (e, f) for y in (e, f))
    assert all((~witness).forward().left()(witness.forward().left()(x)) == x for x in source.module_generators())
