r"""DSH polarization orbit rows of the Enriques family, through the public group (#294).

The 87 numerical polarizations of Dutour Sikirić–Hulek (arXiv:2302.01679, Table 1,
p. 13) are indexed by admissible subsets of the Coxeter diagram of $O(U + E_8(-1))$.
The source convention, stated with the table: a group $\Gamma^+_h$ is determined by the
facets of the fundamental domain containing $h$, and when that set has more than five
elements the table lists its *complement* with an overline.  The extreme-ray generators
$g_1, \ldots, g_{10}$ of the fundamental domain form a $\mathbb Z$-basis of
$U + E_8(-1)$ with Gram matrix $W$ (source equation (7)); the wall normals
$\alpha_i$ satisfy $\alpha_i \cdot g_j = \delta_{ij}$, so a polarization
$h = \sum a_j g_j$ in the closed domain lies on wall $i$ exactly when $a_i = 0$.

The invariant lattice of the Enriques involution on $L_{K3}$ is the *scaled* model
$M \cong U(2) + E_8(-2)$ of rank 10 and determinant $-1024$ (verified in the
application: never the unimodular unscaled $U + E_8(-1)$), and $h$ is a vector of
$M(1/2) = U + E_8(-1)$, so $h^2$ in $M$'s own form is twice the source's degree-$2d$
value.  The public group is ``coinvariant_extension_subgroup``: $O(M,h)$ through the
invariant lattice's own orthogonal group, its image under $\pi_M$, the transport across
the actual discriminant glue, and the exact preimage in $O(N)$ — never a group
generated by arbitrary lifts.

Cited rows (lattice-database ``arithmetic-groups/gamma-h-*.md``, quoting DSH Table 1):

- case 1, $S = \overline{\{0\}}$: $h = g_2$ (source Table 3 identifies $g_2$; degree 2,
  $\varphi(h_{\min}) = 1$), lines 5, planes 9, flags 18;
- case 2, $S = \overline{\{-1,0\}}$: $h = g_1 + g_2$ (source Section 3.2 names this
  degree-4 representative), lines 7, planes 13, flags 28.

Each case is split per rank so one specimen's cost cannot hide another's result, and
$N = T_{\mathrm{En}}$ is checked against the ``029J`` card's invariants (rank 12,
determinant 1024, signature $(2,10)$) so the arithmetic family cannot be silently
substituted.
"""

from sage_extensions.all import *  # noqa: F401,F403

# The Gram matrix W = (g_i . g_j) of the ten extreme-ray generators, DSH equation (7).
_DSH_W_ROWS = (
    (0, 1, 2, 2, 3, 3, 4, 4, 5, 6),
    (1, 2, 4, 4, 6, 6, 8, 8, 10, 12),
    (2, 4, 4, 6, 7, 8, 9, 10, 12, 14),
    (2, 4, 6, 6, 9, 9, 12, 12, 15, 18),
    (3, 6, 7, 9, 10, 12, 14, 15, 18, 21),
    (3, 6, 8, 9, 12, 12, 16, 16, 20, 24),
    (4, 8, 9, 12, 14, 16, 18, 20, 24, 28),
    (4, 8, 10, 12, 15, 16, 20, 20, 25, 30),
    (5, 10, 12, 15, 18, 20, 24, 25, 30, 36),
    (6, 12, 14, 18, 21, 24, 28, 30, 36, 42),
)

# (case, source-named h as g-indices 1-based, h^2 in M's doubled form, lines, planes, flags)
_CASES = (
    (1, (2,), 4, 5, 9, 18),
    (2, (1, 2), 8, 7, 13, 28),
)


def _doubled_invariant_model():
    r"""$M$'s doubled $g$-basis model: the form $2W$, determinant $-1024$."""
    return Lattices(ZZ)(
        [list(2 * entry for entry in row) for row in _DSH_W_ROWS]
    )


def test_the_dsh_fundamental_domain_model_is_the_source_lattice() -> None:
    r"""$W$'s lattice is unimodular of signature $(1,9)$: $U + E_8(-1)$."""
    model = Lattices(ZZ)([list(row) for row in _DSH_W_ROWS])
    assert model.determinant() == ZZ(-1)
    signature = model.signature_pair()
    assert signature.first() == cardinal(1)
    assert signature.second() == cardinal(9)
    # The Gram is symmetric by construction; the source's W has zero only at (1,1)
    # and (2,2) = 2, which the doubled model's degree checks below rely on.
    gram = model.gram_tensor()
    assert gram[0, 0] == ZZ(0)
    assert gram[1, 1] == ZZ(2)


def test_the_doubled_model_matches_the_invariant_lattice() -> None:
    r"""The doubled $g$-model has the scaled invariant lattice's invariants."""
    model = _doubled_invariant_model()
    assert model.determinant() == ZZ(-1024)
    signature = model.signature_pair()
    assert signature.first() == cardinal(1)
    assert signature.second() == cardinal(9)
    invariant = Involutions.I_En.invariant_lattice()
    assert invariant.module_rank() == cardinal(10)
    assert invariant.determinant() == ZZ(-1024)


def _case_polarization(case):
    r"""Return ``(h_M, h_K3)`` for the source-named case representative."""
    case_number, g_indices, expected_square, *_rest = case
    invariant = Involutions.I_En.invariant_lattice()
    doubled = _doubled_invariant_model()
    transport = doubled.isometry_to(invariant)
    labels = tuple(doubled.module_generating_set())
    h = sum(
        (doubled.module_generator(labels[index - 1]) for index in g_indices),
        doubled.zero(),
    )
    assert h.q() == ZZ(expected_square), (
        f"case {case_number}: h^2 = {h.q()} in M's form, the source degree needs "
        f"{expected_square}"
    )
    h_M = transport(h)
    assert h_M.q() == ZZ(expected_square)
    return h_M, invariant.inclusion()(h_M)


def test_case_1_line_orbits() -> None:
    r"""Case 1 ($h = g_2$): five orbits of isotropic lines in $N$ (DSH Table 1)."""
    _h_M, h_K3 = _case_polarization(_CASES[0])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(1).cardinality() == cardinal(5)


def test_case_1_plane_orbits() -> None:
    r"""Case 1: nine orbits of isotropic planes in $N$ (DSH Table 1)."""
    _h_M, h_K3 = _case_polarization(_CASES[0])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(2).cardinality() == cardinal(9)


def test_case_1_flag_orbits() -> None:
    r"""Case 1: eighteen orbits of isotropic flags in $N$ (DSH Table 1)."""
    _h_M, h_K3 = _case_polarization(_CASES[0])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(2, flag=True).cardinality() == cardinal(18)


def test_case_2_line_orbits() -> None:
    r"""Case 2 ($h = g_1 + g_2$): seven orbits of isotropic lines in $N$."""
    _h_M, h_K3 = _case_polarization(_CASES[1])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(1).cardinality() == cardinal(7)


def test_case_2_plane_orbits() -> None:
    r"""Case 2: thirteen orbits of isotropic planes in $N$."""
    _h_M, h_K3 = _case_polarization(_CASES[1])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(2).cardinality() == cardinal(13)


def test_case_2_flag_orbits() -> None:
    r"""Case 2: twenty-eight orbits of isotropic flags in $N$."""
    _h_M, h_K3 = _case_polarization(_CASES[1])
    group = Involutions.I_En.polarized(h_K3).coinvariant_extension_subgroup()
    assert group.isotropic_orbit_representatives(2, flag=True).cardinality() == cardinal(28)


def test_the_anti_invariant_lattice_is_the_029j_card_lattice() -> None:
    r"""$N = T_{\mathrm{En}}$: rank 12, determinant 1024, signature $(2,10)$."""
    anti_invariant = Involutions.I_En.formed_coinvariants()
    assert anti_invariant.module_rank() == cardinal(12)
    assert anti_invariant.determinant() == ZZ(1024)
    signature = anti_invariant.signature_pair()
    assert signature.first() == cardinal(2)
    assert signature.second() == cardinal(10)
