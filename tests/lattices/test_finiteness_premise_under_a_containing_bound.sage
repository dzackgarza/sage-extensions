r"""A supplied stable containing bound makes the group's finiteness query dead.

`IntegralStructureAction.invariant_module_construction` and
`OrbitSpanConstructions` each branch on

    <the finiteness of the group>  AND  <no containing bound was supplied>,

and the second operand decides both branches: with a bound, the least stable
module is the bounded ascending chain and the group's order is never consulted;
without one, the order decides between the finite fast span and refusing.

Written in that order, the finiteness question is asked *first* and its answer
discarded.  For a group whose order is undecided that question is not cheap: it
falls through to GAP's `IsFinite` over the group's generators, which is minutes
and gigabytes on the indefinite orthogonal groups a lattice consumer works
with.  The two sites now ask `containing is None` first, which is an
evaluation-order change: the predicate, its hypotheses and both branches are
the same, and the query still runs wherever it can change the result.

These tests measure the premise rather than a clock.  The instrument is the
group's own method, replaced on that one object and put back afterwards, so the
group and its answer stay real; what is counted is how often the question is
asked.
"""

import pytest

from sage_extensions.all import *  # noqa: F401,F403


def _specimen():
    r"""``U`` over ``QQ``, the isotropic line ``ZZ e_0``, and the supplied subgroup ``⟨swap⟩``.

    The subgroup is generated by a supplied isometry, which is what the orbit
    machinery reads; the whole rational ``O`` supplies no generator family of
    its own.  ``ZZ e_0 + ZZ e_1`` is a stable finitely generated bound
    containing the line, so the bounded branch is this specimen's normal path.
    """
    plane = Lattices(QQ)("U")
    restriction = Modules(QQ).restriction_of_scalars(ZZ.Mor(QQ)(lambda n: QQ(n)))
    space = restriction(plane)
    labels = plane.module_generating_set()
    basis = [plane.module_generator(label) for label in labels]
    orthogonal_group = plane.Aut()
    swap = orthogonal_group(lambda label: basis[1 - int(label)])
    group = orthogonal_group.subgroup((swap,))
    line = space.subobject_on([space(basis[0])])
    standard = space.subobject_on([space(basis[0]), space(basis[1])])
    return group, line, standard


class _Questions:
    r"""Count the questions ``group.is_finite()``, answering each with the group's own answer.

    The replacement is that one group object's own attribute and is removed
    again when the block ends, so nothing about the group or its category is
    rebuilt.
    """

    def __init__(self, group):
        self.group = group
        self.count = 0

    def __enter__(self):
        self.original = self.group.is_finite
        questions = self

        def is_finite():
            questions.count += 1
            return questions.original()

        self.group.is_finite = is_finite
        return self

    def __exit__(self, *exception):
        del self.group.is_finite
        return False


class _Answer:
    r"""Answer ``group.is_finite()`` with a stated value: the branch, made observable."""

    def __init__(self, group, answer):
        self.group = group
        self.answer = answer

    def __enter__(self):
        def is_finite():
            return self.answer

        self.group.is_finite = is_finite
        return self

    def __exit__(self, *exception):
        del self.group.is_finite
        return False


def _span_images(construction):
    inclusion = construction.inclusion()
    return tuple(inclusion(generator) for generator in inclusion.domain().module_generators())


def _same_span(left, right):
    r"""Whether two orbit-generated submodules have the same points.

    Elements are not hashable, so the comparison is pairwise; the frames of two
    separately constructed spans are separately chosen and are not compared.
    """
    left_images, right_images = _span_images(left), _span_images(right)
    return all(
        any((image == other) is True for other in right_images) for image in left_images
    ) and all(
        any((image == other) is True for other in left_images) for image in right_images
    )


def test_a_supplied_containing_bound_never_asks_whether_the_group_is_finite() -> None:
    r"""The bounded construction asks nothing: its answer is dead data.

    Two queries are removed here, one at each site -- the action's own branch
    and the orbit span's -- and both are visible in this one call.
    """
    group, line, standard = _specimen()
    bounded = IntegralStructureAction(group, line.inclusion()).with_stable_containing_bound(
        standard.inclusion(), check=True
    )

    with _Questions(group) as asked:
        construction = bounded.invariant_module_construction()

    assert asked.count == 0, (
        f"the bounded construction asked whether {group} is finite {asked.count} time(s), "
        "though a stable containing bound decides the branch"
    )
    assert construction.inclusion().domain().module_rank() == 2


def test_without_a_bound_the_query_still_decides_and_is_still_asked() -> None:
    r"""The unbounded path keeps the question, and the same span comes out.

    Removing the dead query must not remove the live one: with no bound the
    group's order decides between closing the orbit and refusing.
    """
    group, line, standard = _specimen()
    action = IntegralStructureAction(group, line.inclusion())
    bounded = action.with_stable_containing_bound(standard.inclusion(), check=True)

    with _Questions(group) as asked:
        unbounded_construction = action.invariant_module_construction()
    assert asked.count >= 1, (
        "the unbounded construction did not ask whether the group is finite, but that answer decides it"
    )

    with _Questions(group) as asked:
        bounded_construction = bounded.invariant_module_construction()
    assert asked.count == 0
    assert _same_span(bounded_construction, unbounded_construction)


def test_the_orbit_span_alone_asks_nothing_when_it_is_given_a_bound() -> None:
    r"""The second site, on its own: bounded closure never consults the order."""
    group, line, standard = _specimen()
    functor = IntegralStructureAction(group, line.inclusion()).ambient_action_functor()
    g_objects = GObjects(group, Modules(ZZ))

    with _Questions(group) as asked:
        g_objects.orbit_generated_submodule(
            functor, line.inclusion(), containing=standard.inclusion()
        )
    assert asked.count == 0

    with _Questions(group) as asked:
        g_objects.orbit_generated_submodule(functor, line.inclusion())
    assert asked.count >= 1


def test_the_discarded_answer_cannot_change_the_bounded_span() -> None:
    r"""Forcing the order true or false leaves the bounded construction identical.

    This is why the reorder is sound rather than an assumption: the two answers
    reach the same branch, so the same submodule is built either way.
    """
    group, line, standard = _specimen()
    with _Answer(group, True):
        reference = IntegralStructureAction(group, line.inclusion()).with_stable_containing_bound(
            standard.inclusion(), check=True
        ).invariant_module_construction()

    for forced in (True, False):
        with _Answer(group, forced):
            again = IntegralStructureAction(group, line.inclusion()).with_stable_containing_bound(
                standard.inclusion(), check=True
            ).invariant_module_construction()
        assert _same_span(again, reference), (
            f"answering the finiteness question with {forced} changed the bounded orbit-generated module"
        )


def test_without_a_bound_an_infinite_group_is_still_refused() -> None:
    r"""The hypothesis keeps its teeth: no bound and a non-finite order refuses."""
    group, line, standard = _specimen()
    action = IntegralStructureAction(group, line.inclusion())

    with _Answer(group, False):
        with pytest.raises(AssertionError):
            action.invariant_module_construction()
