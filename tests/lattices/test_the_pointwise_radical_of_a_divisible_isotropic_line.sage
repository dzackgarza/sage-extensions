r"""The radical of a pointed isotropic line whose vector has divisibility above one.

Write `I = Z e`, `d` for the divisibility of `e`, `J = I^perp` and fix a
partner `w` with `b(e, w) = d`, so `L = J + Z w`.  An element of the radical
`U_I` sends `y in J` to `y + c(y) e` and `w` to `w + z`, and the isometry
equations are `d c(y) = -b(y, z)` and `b(z, z) + 2 b(w, z) = 0`.  The Eichler
transvection at a rational parameter `x` reads

    y |-> y - b(y, x) e,        w |-> w + d x - (b(w,x) + (d/2) b(x,x)) e,

and it lies in `U_I` for every `x`; its integrality is three conditions on
`u = d x`, which lies in `J` exactly when `x` does:

    b(u, J) inside d Z,        u in L,        b(u,u) + 2 b(w,u) in 2d Z.

Those cut out a lattice `X` -- the pairing `b(u,u) + 2b(w,u)` is additive
modulo `2d` there, because the cross term of two such vectors is `2b(u,u')`
and `u' in J` makes `b(u,u')` a multiple of `d` -- and `x = u/d` runs over
`X/d` with kernel `(1/d) Z e`, so `X/Z e` is the radical, of rank
`rank K_I`.  At `d = 1` the three conditions are `u in J`, nothing, and
`b(u,u)` even: the even part of `J`.

The specimens are Gram matrices, and each asserts the property that makes it
the specimen it is: `U(d) + <d>` has `K_I = <d>` of rank one, and there the
radical is generated by the transvection at `2g/d`, of square `4d`; the
rank-four `U(2) + <2> + <2>` has `K_I` of rank two, so its radical needs two
parameters and the congruence can bind on a class rather than on a single
coordinate.  Nothing here is typed that the lattice does not decide: the
generators are asserted to fix the vector, to lie in the radical, and to
number as many as `K_I` has rank.
"""

from sage_extensions.all import *  # noqa: F401,F403

DIVISIBILITY_TWO = [[0, 2, 0], [2, 0, 0], [0, 0, 2]]
DIVISIBILITY_THREE = [[0, 3, 0], [3, 0, 0], [0, 0, 3]]
DIVISIBILITY_TWO_RANK_TWO = [[0, 2, 0, 0], [2, 0, 0, 0], [0, 0, 2, 0], [0, 0, 0, 2]]


def _radical(gram):
    r"""The lattice, its marked vector, and the radical's generators at that line."""
    lattice = Lattices(ZZ)(gram)
    labels = tuple(lattice.module_generating_set())
    vector = lattice.module_generator(labels[0])
    reduction = lattice.primitive_isotropic_subobject(vector).isotropic_reduction()
    return lattice, vector, reduction, tuple(reduction.unipotent_kernel().group_generators())


def _assert_the_family_is_the_radical(gram, divisibility) -> None:
    r"""The radical is non-empty, fixes the vector, and acts trivially on `K_I`.

    Completeness -- that these generate the whole radical and not a proper
    subgroup of it -- is the parameter lattice's statement and is carried by
    :meth:`...IsotropicReductions._pointwise_kernel_parameter_vectors`'s
    docstring, the way it is at divisibility one; what a test can assert is
    that each generator is an element of the radical and that the family is
    not empty, which is what fails when the call refuses.
    """
    lattice, vector, reduction, family = _radical(gram)
    quotient = reduction.quotient_lattice()
    action = reduction.pointwise_levi_action()

    assert vector.q() == ZZ(0)
    assert vector.is_primitive() is True
    assert vector.div() == ZZ(divisibility)
    assert lattice.is_even() is (divisibility % 2 == 0)
    assert quotient.module_rank() >= NN(1)

    assert family
    for isometry in family:
        assert isometry(vector) == vector
        assert action(isometry) == action.codomain().one()
        assert all(
            lattice.b(isometry(left), isometry(right)) == lattice.b(left, right)
            for left in lattice.module_generators()
            for right in lattice.module_generators()
        )


def test_the_divisible_line_of_rank_one_quotient_has_its_radical() -> None:
    r"""`U(2) + <2>`: `K_I = <2>`, and the radical is the transvection at `g`, of square two."""
    _assert_the_family_is_the_radical(DIVISIBILITY_TWO, 2)


def test_the_odd_divisible_line_of_rank_one_quotient_has_its_radical() -> None:
    r"""`U(3) + <3>` is odd; the parameter lattice there is not the even part of `I^perp`."""
    _assert_the_family_is_the_radical(DIVISIBILITY_THREE, 3)


def test_the_divisible_line_of_rank_two_quotient_has_its_radical() -> None:
    r"""`U(2) + <2> + <2>`: two parameters, and the congruence binds on their sum."""
    _assert_the_family_is_the_radical(DIVISIBILITY_TWO_RANK_TWO, 2)
