diff --git a/.github/workflows/isotropic-reduction-image-tests.yml b/.github/workflows/isotropic-reduction-image-tests.yml
index 7524f21..9c0811a 100644
--- a/.github/workflows/isotropic-reduction-image-tests.yml
+++ b/.github/workflows/isotropic-reduction-image-tests.yml
@@ -48,10 +48,15 @@ jobs:
           just test tests/lattices/test_the_isotropic_reduction_image.sage \
             --no-time-gates --timeout "$TEST_TIMEOUT" -v
         shell: bash
-      - name: Keep the run's timing and report log
+      # The run's own timing record (CONTRIBUTING.md ENV-03): the report log and
+      # JUnit file this run's plugin copied into .timings/, named by commit and
+      # start time, and the library's stage records beside them.  tests/.report/
+      # is not uploaded: the next run overwrites it.
+      - name: Keep the run's timing record
         if: always()
         uses: actions/upload-artifact@v4
         with:
-          name: reduction-image-report-${{ github.sha }}
-          path: tests/.report/
+          name: timings-${{ github.job }}-${{ github.sha }}
+          path: .timings/
           retention-days: 90
