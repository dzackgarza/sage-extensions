    def test_g2_and_g3_generate_the_cyclic_group_of_order_6() -> None:
        r"""$\gcd(2, 3) = 1$, so $\langle g^2, g^3 \rangle = \langle g \rangle = C_6$; as a $\mathbb Z$-module,
