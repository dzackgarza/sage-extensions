    def test_gaussian_field_tensor_itself_over_qq_splits_by_an_idempotent() -> None:
        r"""``QQ(i) ⊗_QQ QQ(i) ≅ QQ(i) × QQ(i)``: ``e = (1 + i ⊗ i)/2`` satisfies
        ``e^2 = e`` (as ``(i ⊗ i)^2 = i^2 ⊗ i^2 = 1``) and ``e ≠ 0, 1``, so the
