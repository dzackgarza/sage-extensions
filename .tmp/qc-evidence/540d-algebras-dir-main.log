    def test_de_rham_cohomology_of_the_rational_dual_numbers() -> None:
        r"""For ``A = QQ[x]/(x^2)``: ``2x dx = d(x^2) = 0`` so ``Ω = QQ dx``; ``d`` is
        onto ``Ω``, giving ``H^0 = QQ`` and ``H^1 = 0``."""
        polynomials = QQ["x"]
