                if basis_cardinality == cardinal(0):
                    return cardinal(1)
                return Cardinalities().supremum(aleph(0), basis_cardinality)
            case _ if group in OwnedInfiniteGroups() and group in OwnedGroups().FinitelyGeneratedAsMagma():
