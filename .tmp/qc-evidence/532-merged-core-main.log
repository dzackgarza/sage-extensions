    def test_triangle_with_vertices_0_0_0_3_6_0_satisfies_pick() -> None:
        r"""Area 9; boundary points `\gcd(0,3) + \gcd(6,3) + \gcd(6,0) = 3 + 3 + 6 = 12`;
        Pick's theorem `9 = I + 12/2 - 1` gives 4 interior points, 16 in all."""
