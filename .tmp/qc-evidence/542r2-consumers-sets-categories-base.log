        f2(x) = exp(-abs(x))
        f3(x) = x * exp(-x * x)
        integral = space.integration_morphism()
        gaussian = space(f1)
        laplace = space(f2)
    
        assert integral.domain() is space
        assert integral(gaussian) == sqrt(pi)
        assert integral(laplace) == 2
        assert integral(gaussian + laplace) == sqrt(pi) + 2
